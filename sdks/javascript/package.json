{
  "name": "licensemanager-sdk",
  "version": "1.0.0",
  "description": "SDK cliente para a API de validação do LicenseManager",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build":   "tsc --noEmit && rollup -c",
    "test":    "jest --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["licensemanager", "sdk", "licensing", "hmac"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/carloscampos2014/LicenciamentoSoftware"
  },
  "devDependencies": {
    "@types/jest":       "^29.5.12",
    "@types/node":       "^20.14.0",
    "jest":              "^29.7.0",
    "ts-jest":           "^29.1.4",
    "typescript":        "^5.4.5",
    "rollup":            "^4.18.0",
    "@rollup/plugin-typescript": "^11.1.6",
    "tslib":             "^2.6.3"
  }
}
