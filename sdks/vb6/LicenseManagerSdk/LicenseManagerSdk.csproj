<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net48 para COM Interop no Windows; netstandard2.0 para compatibilidade ampla -->
    <TargetFrameworks>net48;netstandard2.0</TargetFrameworks>
    <RootNamespace>LicenseManagerSdk</RootNamespace>
    <AssemblyName>LicenseManagerSdk</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- NuGet metadata -->
    <PackageId>LicenseManagerSdk.VB6</PackageId>
    <Version>1.0.0</Version>
    <Authors>LicenciamentoSoftware</Authors>
    <Description>SDK COM para integração com a API de validação do LicenseManager a partir de VB6 e outras linguagens COM.</Description>
    <PackageTags>licensemanager;sdk;com;vb6;activeX</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/carloscampos2014/LicenciamentoSoftware</RepositoryUrl>
  </PropertyGroup>

  <!-- HttpClient e System.Net.Http para net48 e netstandard2.0 -->
  <ItemGroup>
    <PackageReference Include="System.Net.Http"  Version="4.3.4" Condition="'$(TargetFramework)' == 'net48'" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

</Project>
