{
  "Cors": {
    "AllowedOrigins": [
      "https://localhost:7152",
      "http://localhost:5074",
      "https://localhost:49250",
      "http://localhost:49251"
    ]
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=licenciamento_dev;Username=postgres;Password=${DB_PASSWORD}"
  },
  "JwtSettings": {
    "Secret": "${JWT_SECRET}",
    "Emissor": "LicenciamentoSoftware",
    "Audiencia": "LicenciamentoSoftware",
    "AccessTokenMinutos": 60
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    }
  },
  "JobSettings": {
    "DelayInicialSegundos": 10,
    "SessoesInativasIntervaloMinutos": 2,
    "SessoesInativasLimiteHoras": 1,
    "DiasAntecedenciaNotificacao": 30
  },
  "EmailSettings": {
    "Habilitado": false,
    "NomeRemetente": "LicenciamentoSoftware [Dev]"
  }
}
