{
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": []
  },
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "JwtSettings": {
    "Secret": "",
    "Emissor": "LicenciamentoSoftware",
    "Audiencia": "LicenciamentoSoftware",
    "AccessTokenMinutos": 60
  },
  "LicencaTokenSettings": {
    "DefaultExpiracaoMinutos": 525600,
    "AntiReplayJanelaMinutos": 5
  },
  "RateLimiting": {
    "ValidacaoRequisicoesPorMinuto": 60
  },
  "JobSettings": {
    "DelayInicialSegundos": 30,
    "SessoesInativasIntervaloMinutos": 5,
    "SessoesInativasLimiteHoras": 24,
    "ExpiracaoLicencasIntervaloMinutos": 60,
    "RenovacaoAutomaticaIntervaloMinutos": 60,
    "RotacaoTokensIntervaloMinutos": 720,
    "NotificacaoIntervaloMinutos": 1440,
    "DiasAntecedenciaNotificacao": 7
  },
  "EmailSettings": {
    "Habilitado": false,
    "Host": "",
    "Porta": 587,
    "UsarSsl": false,
    "Usuario": "",
    "Senha": "",
    "EmailRemetente": "",
    "NomeRemetente": "LicenciamentoSoftware"
  },
  "HangfireSettings": {
    "Usuario": "admin",
    "Senha": "",
    "CronSessoesInativas":   "*/5 * * * *",
    "CronExpiracaoLicencas": "0 * * * *",
    "CronRenovacaoAutomatica": "15 * * * *",
    "CronRotacaoTokens":     "0 2 * * *",
    "CronNotificacao":       "0 8 * * *",
    "CronExclusaoEmpresas":  "0 3 * * *"
  },
  "AppSettings": {
    "PortalUrl": "http://localhost:5017"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}{NewLine}{Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/licenciamento-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithEnvironmentName" ]
  }
}
