<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:conv="clr-namespace:LicenciamentoSoftware.Maui.Converters"
             x:Class="LicenciamentoSoftware.Maui.App">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters globais -->
            <conv:StringNotNullConverter  x:Key="StringNotNullConverter" />
            <conv:StringNullOrEmptyConverter x:Key="StringNullOrEmptyConverter" />
            <conv:InverseBoolConverter    x:Key="InverseBoolConverter" />
            <conv:TipoInscricaoConverter  x:Key="TipoInscricaoConverter" />
            <conv:TipoInscricaoTextoConverter x:Key="TipoInscricaoTextoConverter" />
        </ResourceDictionary>
    </Application.Resources>

</Application>
