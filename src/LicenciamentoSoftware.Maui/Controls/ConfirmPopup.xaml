<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LicenciamentoSoftware.Maui.Controls.ConfirmPopup"
             IsVisible="False">

    <!-- Overlay escurecido -->
    <Grid BackgroundColor="#80000000">
        <Border Style="{StaticResource Card}"
                BackgroundColor="{StaticResource Surface}"
                Padding="24" WidthRequest="300"
                HorizontalOptions="Center"
                VerticalOptions="Center">
            <Border.StrokeShape>RoundRectangle 12</Border.StrokeShape>

            <VerticalStackLayout Spacing="16">

                <Label x:Name="LabelTitulo"
                       FontSize="16" FontAttributes="Bold"
                       TextColor="{StaticResource TextPrimary}" />

                <Label x:Name="LabelMensagem"
                       FontSize="14"
                       TextColor="{StaticResource TextSecondary}"
                       LineBreakMode="WordWrap" />

                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Button Grid.Column="0"
                            x:Name="BotaoCancelar"
                            Text="Cancelar"
                            Style="{StaticResource BotaoSecundario}"
                            Clicked="OnCancelarClicked" />

                    <Button Grid.Column="1"
                            x:Name="BotaoConfirmar"
                            Text="Confirmar"
                            Style="{StaticResource BotaoPerigo}"
                            Clicked="OnConfirmarClicked" />
                </Grid>

            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentView>
