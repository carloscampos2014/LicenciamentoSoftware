<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Paleta principal — espelha o app.css do Web -->
    <Color x:Key="Primary">#6c63ff</Color>
    <Color x:Key="PrimaryDark">#5a52e0</Color>
    <Color x:Key="PrimaryLight">#f0eeff</Color>

    <Color x:Key="Secondary">#10b981</Color>
    <Color x:Key="Danger">#dc3545</Color>
    <Color x:Key="Warning">#f59e0b</Color>
    <Color x:Key="Info">#3b82f6</Color>

    <Color x:Key="Background">#f8f9fa</Color>
    <Color x:Key="Surface">#ffffff</Color>
    <Color x:Key="Border">#e9ecef</Color>

    <Color x:Key="TextPrimary">#212529</Color>
    <Color x:Key="TextSecondary">#6c757d</Color>
    <Color x:Key="TextMuted">#adb5bd</Color>

    <!-- Badges por tipo de licença -->
    <Color x:Key="BadgePermanenteBg">#dbeafe</Color>
    <Color x:Key="BadgePermanenteFg">#1e40af</Color>
    <Color x:Key="BadgePeriodoBg">#fef3c7</Color>
    <Color x:Key="BadgePeriodoFg">#92400e</Color>
    <Color x:Key="BadgeUsuariosBg">#ede9fe</Color>
    <Color x:Key="BadgeUsuariosFg">#5b21b6</Color>
    <Color x:Key="BadgeInstalacaoBg">#fce7f3</Color>
    <Color x:Key="BadgeInstalacaoFg">#9d174d</Color>
    <Color x:Key="BadgeAtivoBg">#d1fae5</Color>
    <Color x:Key="BadgeAtivoFg">#065f46</Color>
    <Color x:Key="BadgeInativoBg">#f3f4f6</Color>
    <Color x:Key="BadgeInativoFg">#6b7280</Color>

</ResourceDictionary>
