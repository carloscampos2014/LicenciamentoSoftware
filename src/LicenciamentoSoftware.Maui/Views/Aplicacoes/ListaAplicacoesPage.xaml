<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LicenciamentoSoftware.Maui.ViewModels.Aplicacoes"
             xmlns:model="clr-namespace:LicenciamentoSoftware.Client.Models.Aplicacoes;assembly=LicenciamentoSoftware.Client"
             x:Class="LicenciamentoSoftware.Maui.Views.Aplicacoes.ListaAplicacoesPage"
             x:DataType="vm:ListaAplicacoesViewModel"
             Title="{Binding Titulo}"
             BackgroundColor="{StaticResource Background}">

    <Grid RowDefinitions="Auto,*">

        <Grid Grid.Row="0" Padding="16,12,16,8" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8"
              BackgroundColor="{StaticResource Surface}">
            <Border Grid.Column="0" BackgroundColor="{StaticResource Surface}"
                    Stroke="{StaticResource Border}" StrokeThickness="1" Padding="12,0">
                <Border.StrokeShape>RoundRectangle 8</Border.StrokeShape>
                <Entry Text="{Binding Busca}" Placeholder="Buscar por título..."
                       ReturnCommand="{Binding BuscarCommand}"
                       TextColor="{StaticResource TextPrimary}"
                       PlaceholderColor="{StaticResource TextMuted}"
                       FontSize="14" HeightRequest="40" />
            </Border>
            <Button Grid.Column="1" Text="Buscar" Command="{Binding BuscarCommand}"
                    BackgroundColor="{StaticResource Surface}"
                    TextColor="{StaticResource TextPrimary}"
                    BorderColor="{StaticResource Border}" BorderWidth="1"
                    CornerRadius="8" HeightRequest="40" FontSize="14" WidthRequest="80" />
            <Button Grid.Column="2" Text="+ Nova" Command="{Binding AbrirFormularioCriarCommand}"
                    BackgroundColor="{StaticResource Primary}" TextColor="White"
                    CornerRadius="8" HeightRequest="40" FontSize="14" FontAttributes="Bold"
                    WidthRequest="100" />
        </Grid>

        <RefreshView Grid.Row="1" IsRefreshing="{Binding Ocupado}" Command="{Binding RecarregarCommand}">
            <ScrollView>
                <VerticalStackLayout Padding="16,12" Spacing="0">

                    <Border IsVisible="{Binding Erro, Converter={StaticResource StringNotNullConverter}}"
                            BackgroundColor="{StaticResource DangerLight}"
                            Stroke="{StaticResource Danger}" StrokeThickness="1"
                            Padding="12,10" Margin="0,0,0,12">
                        <Border.StrokeShape>RoundRectangle 8</Border.StrokeShape>
                        <Label Text="{Binding Erro}" TextColor="{StaticResource Danger}" FontSize="13" />
                    </Border>

                    <CollectionView ItemsSource="{Binding Itens}"
                                    RemainingItemsThreshold="3"
                                    RemainingItemsThresholdReachedCommand="{Binding CarregarMaisCommand}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="model:AplicacaoResult">
                                <Border BackgroundColor="{StaticResource Surface}"
                                        Stroke="{StaticResource Border}" StrokeThickness="1"
                                        Padding="16,14" Margin="0,0,0,10">
                                    <Border.StrokeShape>RoundRectangle 10</Border.StrokeShape>
                                    <Border.Shadow>
                                        <Shadow Brush="#000000" Offset="0,2" Radius="6" Opacity="0.06" />
                                    </Border.Shadow>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.AbrirFormularioEditarCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>

                                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="5">

                                        <Label Grid.Row="0" Grid.Column="0"
                                               Text="{Binding Titulo}"
                                               FontSize="15" FontAttributes="Bold"
                                               TextColor="{StaticResource TextPrimary}" />

                                        <Border Grid.Row="0" Grid.Column="1"
                                                Padding="10,4" StrokeThickness="0" VerticalOptions="Center">
                                            <Border.StrokeShape>RoundRectangle 12</Border.StrokeShape>
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding Ativo}" Value="True">
                                                    <Setter Property="BackgroundColor" Value="{StaticResource SuccessLight}" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Border" Binding="{Binding Ativo}" Value="False">
                                                    <Setter Property="BackgroundColor" Value="{StaticResource DangerLight}" />
                                                </DataTrigger>
                                            </Border.Triggers>
                                            <Label FontSize="11" FontAttributes="Bold">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding Ativo}" Value="True">
                                                        <Setter Property="Text" Value="Ativa" />
                                                        <Setter Property="TextColor" Value="{StaticResource Success}" />
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Label" Binding="{Binding Ativo}" Value="False">
                                                        <Setter Property="Text" Value="Inativa" />
                                                        <Setter Property="TextColor" Value="{StaticResource Danger}" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                        </Border>

                                        <!-- Tipo de licença badge -->
                                        <Border Grid.Row="1" Grid.Column="0"
                                                BackgroundColor="{StaticResource BadgePermanenteBg}"
                                                StrokeThickness="0" Padding="8,3"
                                                HorizontalOptions="Start">
                                            <Border.StrokeShape>RoundRectangle 10</Border.StrokeShape>
                                            <Label Text="{Binding TipoLicencaDescricao}"
                                                   FontSize="11" FontAttributes="Bold"
                                                   TextColor="{StaticResource BadgePermanenteFg}" />
                                        </Border>

                                        <!-- Descrição -->
                                        <Label Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                               Text="{Binding Descricao}"
                                               FontSize="12" TextColor="{StaticResource TextMuted}"
                                               IsVisible="{Binding Descricao, Converter={StaticResource StringNotNullConverter}}"
                                               LineBreakMode="TailTruncation" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>

                        <CollectionView.Footer>
                            <VerticalStackLayout Padding="0,8,0,24">
                                <ActivityIndicator IsRunning="{Binding Ocupado}" IsVisible="{Binding Ocupado}"
                                                   Color="{StaticResource Primary}" />
                            </VerticalStackLayout>
                        </CollectionView.Footer>

                        <CollectionView.EmptyView>
                            <VerticalStackLayout HorizontalOptions="Center" Margin="0,48,0,0" Spacing="8">
                                <Label Text="Nenhuma aplicação encontrada"
                                       FontSize="16" TextColor="{StaticResource TextSecondary}"
                                       HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </CollectionView.EmptyView>
                    </CollectionView>

                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

        <!-- Formulário overlay -->
        <Grid Grid.RowSpan="2" IsVisible="{Binding ExibirFormulario}" BackgroundColor="#88000000">
            <Border BackgroundColor="{StaticResource Surface}"
                    Stroke="{StaticResource Border}" StrokeThickness="1"
                    Margin="32" Padding="28,24"
                    VerticalOptions="Center" MaximumWidthRequest="480" HorizontalOptions="Center">
                <Border.StrokeShape>RoundRectangle 14</Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#000000" Offset="0,8" Radius="24" Opacity="0.15" />
                </Border.Shadow>
                <ScrollView>
                    <VerticalStackLayout Spacing="12">

                        <Label FontSize="18" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" Margin="0,0,0,4">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding IdEdicao}" Value="{x:Null}">
                                    <Setter Property="Text" Value="Nova Aplicação" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                        <BoxView HeightRequest="1" BackgroundColor="{StaticResource Border}" Margin="0,0,0,4" />

                        <Label Text="Título *" Style="{StaticResource LabelCampo}" />
                        <Border BackgroundColor="{StaticResource Surface}" Stroke="{StaticResource Border}" StrokeThickness="1" Padding="12,0">
                            <Border.StrokeShape>RoundRectangle 8</Border.StrokeShape>
                            <Entry Text="{Binding FormTitulo}" Placeholder="Nome da aplicação"
                                   TextColor="{StaticResource TextPrimary}" FontSize="14" HeightRequest="44" />
                        </Border>

                        <Label Text="Descrição" Style="{StaticResource LabelCampo}" />
                        <Border BackgroundColor="{StaticResource Surface}" Stroke="{StaticResource Border}" StrokeThickness="1" Padding="12,6">
                            <Border.StrokeShape>RoundRectangle 8</Border.StrokeShape>
                            <Editor Text="{Binding FormDescricao}" Placeholder="Descrição opcional"
                                    TextColor="{StaticResource TextPrimary}" FontSize="14"
                                    HeightRequest="80" AutoSize="TextChanges" />
                        </Border>

                        <Label Text="Tipo de Licença *" Style="{StaticResource LabelCampo}"
                               IsVisible="{Binding IdEdicao, Converter={StaticResource StringNullOrEmptyConverter}}" />
                        <Border BackgroundColor="{StaticResource Surface}" Stroke="{StaticResource Border}" StrokeThickness="1" Padding="4,0"
                                IsVisible="{Binding IdEdicao, Converter={StaticResource StringNullOrEmptyConverter}}">
                            <Border.StrokeShape>RoundRectangle 8</Border.StrokeShape>
                            <Picker ItemsSource="{Binding TiposLicenca}"
                                    SelectedItem="{Binding FormTipoLicencaSelecionado}"
                                    ItemDisplayBinding="{Binding Descricao}"
                                    TextColor="{StaticResource TextPrimary}" FontSize="14" />
                        </Border>

                        <Border IsVisible="{Binding ErroFormulario, Converter={StaticResource StringNotNullConverter}}"
                                BackgroundColor="{StaticResource DangerLight}" Stroke="{StaticResource Danger}" StrokeThickness="1" Padding="10,8">
                            <Border.StrokeShape>RoundRectangle 6</Border.StrokeShape>
                            <Label Text="{Binding ErroFormulario}" TextColor="{StaticResource Danger}" FontSize="13" />
                        </Border>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,8,0,0">
                            <Button Grid.Column="0" Text="Cancelar"
                                    BackgroundColor="{StaticResource Surface}" TextColor="{StaticResource TextPrimary}"
                                    BorderColor="{StaticResource Border}" BorderWidth="1"
                                    CornerRadius="8" HeightRequest="44"
                                    Command="{Binding FecharFormularioCommand}" />
                            <Button Grid.Column="1" Text="Salvar"
                                    BackgroundColor="{StaticResource Primary}" TextColor="White"
                                    CornerRadius="8" HeightRequest="44" FontAttributes="Bold"
                                    Command="{Binding SalvarCommand}" IsEnabled="{Binding NaoOcupado}" />
                        </Grid>
                    </VerticalStackLayout>
                </ScrollView>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
