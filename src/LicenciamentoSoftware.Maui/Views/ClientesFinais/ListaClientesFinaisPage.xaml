<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LicenciamentoSoftware.Maui.ViewModels.ClientesFinais"
             xmlns:model="clr-namespace:LicenciamentoSoftware.Client.Models.ClientesFinais;assembly=LicenciamentoSoftware.Client"
             x:Class="LicenciamentoSoftware.Maui.Views.ClientesFinais.ListaClientesFinaisPage"
             x:DataType="vm:ListaClientesFinaisViewModel"
             Title="{Binding Titulo}"
             BackgroundColor="{StaticResource Background}">

    <Grid RowDefinitions="Auto,*">

        <!-- Barra de ação: busca + botões -->
        <Grid Grid.Row="0" Padding="16,12,16,8" ColumnDefinitions="*,Auto,Auto"
              ColumnSpacing="8" BackgroundColor="{StaticResource Surface}">
            <Border Grid.Column="0" BackgroundColor="{StaticResource Surface}"
                    Stroke="{StaticResource Border}" StrokeThickness="1" Padding="12,0">
                <Border.StrokeShape>RoundRectangle 8</Border.StrokeShape>
                <Entry Text="{Binding Busca}" Placeholder="Buscar por razão social..."
                       ReturnCommand="{Binding BuscarCommand}"
                       TextColor="{StaticResource TextPrimary}"
                       PlaceholderColor="{StaticResource TextMuted}"
                       FontSize="14" HeightRequest="40" />
            </Border>
            <Button Grid.Column="1" Text="Buscar" Command="{Binding BuscarCommand}"
                    BackgroundColor="{StaticResource Surface}"
                    TextColor="{StaticResource TextPrimary}"
                    BorderColor="{StaticResource Border}" BorderWidth="1"
                    CornerRadius="8" HeightRequest="40" FontSize="14" WidthRequest="80" />
            <Button Grid.Column="2" Text="+ Novo" Command="{Binding AbrirFormularioCriarCommand}"
                    BackgroundColor="{StaticResource Primary}" TextColor="White"
                    CornerRadius="8" HeightRequest="40" FontSize="14" FontAttributes="Bold"
                    WidthRequest="100" />
        </Grid>

        <!-- Conteúdo -->
        <RefreshView Grid.Row="1" IsRefreshing="{Binding Ocupado}"
                     Command="{Binding RecarregarCommand}">
            <ScrollView>
                <VerticalStackLayout Padding="16,12" Spacing="0">

                    <!-- Erro -->
                    <Border IsVisible="{Binding Erro, Converter={StaticResource StringNotNullConverter}}"
                            BackgroundColor="{StaticResource DangerLight}"
                            Stroke="{StaticResource Danger}" StrokeThickness="1"
                            Padding="12,10" Margin="0,0,0,12">
                        <Border.StrokeShape>RoundRectangle 8</Border.StrokeShape>
                        <Label Text="{Binding Erro}" TextColor="{StaticResource Danger}" FontSize="13" />
                    </Border>

                    <!-- Lista -->
                    <CollectionView ItemsSource="{Binding Itens}"
                                    RemainingItemsThreshold="3"
                                    RemainingItemsThresholdReachedCommand="{Binding CarregarMaisCommand}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="model:ClienteFinalResult">
                                <Border BackgroundColor="{StaticResource Surface}"
                                        Stroke="{StaticResource Border}" StrokeThickness="1"
                                        Padding="16,14" Margin="0,0,0,10">
                                    <Border.StrokeShape>RoundRectangle 10</Border.StrokeShape>
                                    <Border.Shadow>
                                        <Shadow Brush="#000000" Offset="0,2" Radius="6" Opacity="0.06" />
                                    </Border.Shadow>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.AbrirFormularioEditarCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>

                                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto"
                                          RowSpacing="4">

                                        <!-- Nome + Badge -->
                                        <Label Grid.Row="0" Grid.Column="0"
                                               Text="{Binding RazaoSocial}"
                                               FontSize="15" FontAttributes="Bold"
                                               TextColor="{StaticResource TextPrimary}" />

                                        <Border Grid.Row="0" Grid.Column="1"
                                                Padding="10,4" StrokeThickness="0"
                                                VerticalOptions="Center">
                                            <Border.StrokeShape>RoundRectangle 12</Border.StrokeShape>
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding Ativo}" Value="True">
                                                    <Setter Property="BackgroundColor" Value="{StaticResource SuccessLight}" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Border" Binding="{Binding Ativo}" Value="False">
                                                    <Setter Property="BackgroundColor" Value="{StaticResource DangerLight}" />
                                                </DataTrigger>
                                            </Border.Triggers>
                                            <Label FontSize="11" FontAttributes="Bold">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding Ativo}" Value="True">
                                                        <Setter Property="Text" Value="Ativo" />
                                                        <Setter Property="TextColor" Value="{StaticResource Success}" />
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Label" Binding="{Binding Ativo}" Value="False">
                                                        <Setter Property="Text" Value="Inativo" />
                                                        <Setter Property="TextColor" Value="{StaticResource Danger}" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                        </Border>

                                        <!-- Inscrição -->
                                        <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                               FontSize="13" TextColor="{StaticResource TextSecondary}">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding TipoInscricao, Converter={StaticResource TipoInscricaoTextoConverter}}" />
                                                    <Span Text=": " />
                                                    <Span Text="{Binding NumeroInscricao}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>

                                        <!-- Email -->
                                        <Label Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                               Text="{Binding Email}"
                                               FontSize="12" TextColor="{StaticResource TextMuted}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>

                        <CollectionView.Footer>
                            <VerticalStackLayout Padding="0,8,0,24">
                                <ActivityIndicator IsRunning="{Binding Ocupado}"
                                                   IsVisible="{Binding Ocupado}"
                                                   Color="{StaticResource Primary}" />
                                <Label IsVisible="{Binding TemMaisPaginas, Converter={StaticResource InverseBoolConverter}}"
                                       Text="{Binding TotalRegistros, StringFormat='{0} registros encontrados'}"
                                       FontSize="12" TextColor="{StaticResource TextMuted}"
                                       HorizontalOptions="Center" Margin="0,8,0,0" />
                            </VerticalStackLayout>
                        </CollectionView.Footer>

                        <CollectionView.EmptyView>
                            <VerticalStackLayout HorizontalOptions="Center" Margin="0,48,0,0" Spacing="8">
                                <Label Text="Nenhum cliente encontrado"
                                       FontSize="16" TextColor="{StaticResource TextSecondary}"
                                       HorizontalOptions="Center" />
                                <Label Text="Clique em '+ Novo' para adicionar"
                                       FontSize="13" TextColor="{StaticResource TextMuted}"
                                       HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </CollectionView.EmptyView>
                    </CollectionView>

                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

        <!-- Formulário overlay -->
        <Grid Grid.RowSpan="2" IsVisible="{Binding ExibirFormulario}"
              BackgroundColor="#88000000">
            <Border BackgroundColor="{StaticResource Surface}"
                    Stroke="{StaticResource Border}" StrokeThickness="1"
                    Margin="32" Padding="28,24"
                    VerticalOptions="Center" MaximumWidthRequest="480"
                    HorizontalOptions="Center">
                <Border.StrokeShape>RoundRectangle 14</Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#000000" Offset="0,8" Radius="24" Opacity="0.15" />
                </Border.Shadow>

                <ScrollView>
                    <VerticalStackLayout Spacing="12">

                        <!-- Título do modal -->
                        <Label FontSize="18" FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}" Margin="0,0,0,4">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding IdEdicao}" Value="{x:Null}">
                                    <Setter Property="Text" Value="Novo Cliente Final" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>

                        <BoxView HeightRequest="1" BackgroundColor="{StaticResource Border}" Margin="0,0,0,4" />

                        <Label Text="Razão Social *" Style="{StaticResource LabelCampo}" />
                        <Border BackgroundColor="{StaticResource Surface}"
                                Stroke="{StaticResource Border}" StrokeThickness="1" Padding="12,0">
                            <Border.StrokeShape>RoundRectangle 8</Border.StrokeShape>
                            <Entry Text="{Binding FormRazaoSocial}" Placeholder="Nome / Razão Social"
                                   TextColor="{StaticResource TextPrimary}" FontSize="14" HeightRequest="44" />
                        </Border>

                        <Grid ColumnDefinitions="*,2*" ColumnSpacing="8">
                            <VerticalStackLayout Grid.Column="0">
                                <Label Text="Tipo *" Style="{StaticResource LabelCampo}" />
                                <Border BackgroundColor="{StaticResource Surface}"
                                        Stroke="{StaticResource Border}" StrokeThickness="1" Padding="4,0">
                                    <Border.StrokeShape>RoundRectangle 8</Border.StrokeShape>
                                    <Picker SelectedIndex="{Binding FormTipoInscricao, Converter={StaticResource TipoInscricaoTextoConverter}}"
                                            TextColor="{StaticResource TextPrimary}" FontSize="14">
                                        <Picker.Items>
                                            <x:String>CPF</x:String>
                                            <x:String>CNPJ</x:String>
                                        </Picker.Items>
                                    </Picker>
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1">
                                <Label Text="Número *" Style="{StaticResource LabelCampo}" />
                                <Border BackgroundColor="{StaticResource Surface}"
                                        Stroke="{StaticResource Border}" StrokeThickness="1" Padding="12,0">
                                    <Border.StrokeShape>RoundRectangle 8</Border.StrokeShape>
                                    <Entry Text="{Binding FormNumeroInscricao}" Keyboard="Numeric"
                                           TextColor="{StaticResource TextPrimary}" FontSize="14" HeightRequest="44" />
                                </Border>
                            </VerticalStackLayout>
                        </Grid>

                        <Label Text="E-mail *" Style="{StaticResource LabelCampo}" />
                        <Border BackgroundColor="{StaticResource Surface}"
                                Stroke="{StaticResource Border}" StrokeThickness="1" Padding="12,0">
                            <Border.StrokeShape>RoundRectangle 8</Border.StrokeShape>
                            <Entry Text="{Binding FormEmail}" Keyboard="Email"
                                   Placeholder="email@empresa.com"
                                   TextColor="{StaticResource TextPrimary}" FontSize="14" HeightRequest="44" />
                        </Border>

                        <Label Text="Telefone" Style="{StaticResource LabelCampo}" />
                        <Border BackgroundColor="{StaticResource Surface}"
                                Stroke="{StaticResource Border}" StrokeThickness="1" Padding="12,0">
                            <Border.StrokeShape>RoundRectangle 8</Border.StrokeShape>
                            <Entry Text="{Binding FormTelefone}" Keyboard="Telephone"
                                   Placeholder="(11) 99999-9999"
                                   TextColor="{StaticResource TextPrimary}" FontSize="14" HeightRequest="44" />
                        </Border>

                        <!-- Erro formulário -->
                        <Border IsVisible="{Binding ErroFormulario, Converter={StaticResource StringNotNullConverter}}"
                                BackgroundColor="{StaticResource DangerLight}"
                                Stroke="{StaticResource Danger}" StrokeThickness="1" Padding="10,8">
                            <Border.StrokeShape>RoundRectangle 6</Border.StrokeShape>
                            <Label Text="{Binding ErroFormulario}" TextColor="{StaticResource Danger}" FontSize="13" />
                        </Border>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,8,0,0">
                            <Button Grid.Column="0" Text="Cancelar"
                                    BackgroundColor="{StaticResource Surface}"
                                    TextColor="{StaticResource TextPrimary}"
                                    BorderColor="{StaticResource Border}" BorderWidth="1"
                                    CornerRadius="8" HeightRequest="44"
                                    Command="{Binding FecharFormularioCommand}" />
                            <Button Grid.Column="1" Text="Salvar"
                                    BackgroundColor="{StaticResource Primary}" TextColor="White"
                                    CornerRadius="8" HeightRequest="44" FontAttributes="Bold"
                                    Command="{Binding SalvarCommand}"
                                    IsEnabled="{Binding NaoOcupado}" />
                        </Grid>

                    </VerticalStackLayout>
                </ScrollView>
            </Border>
        </Grid>

    </Grid>
</ContentPage>
