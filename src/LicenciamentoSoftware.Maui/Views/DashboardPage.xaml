<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LicenciamentoSoftware.Maui.ViewModels"
             xmlns:controls="clr-namespace:LicenciamentoSoftware.Maui.Controls"
             xmlns:dash="clr-namespace:LicenciamentoSoftware.Client.Models.Dashboard;assembly=LicenciamentoSoftware.Client"
             x:Class="LicenciamentoSoftware.Maui.Views.DashboardPage"
             x:DataType="vm:DashboardViewModel"
             Title="{Binding Titulo}"
             BackgroundColor="{StaticResource Background}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Atualizar" Command="{Binding CarregarCommand}" />
        <ToolbarItem Text="Sair" Command="{Binding LogoutCommand}" />
    </ContentPage.ToolbarItems>

    <RefreshView IsRefreshing="{Binding Ocupado}"
                 Command="{Binding CarregarCommand}">
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="16">

                <!-- Saudação -->
                <Label FontSize="18" FontAttributes="Bold"
                       TextColor="{StaticResource TextPrimary}">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="Olá, " />
                            <Span Text="{Binding NomeUsuario}" FontAttributes="Bold" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>

                <!-- Erro -->
                <Label Text="{Binding Erro}"
                       Style="{StaticResource LabelErro}"
                       IsVisible="{Binding Erro, Converter={StaticResource StringNotNullConverter}}" />

                <!-- ── Métricas principais ── -->
                <Label Text="Resumo" Style="{StaticResource LabelSecao}" />

                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto"
                      ColumnSpacing="8" RowSpacing="8">

                    <controls:MetricaCardView Grid.Row="0" Grid.Column="0"
                        Titulo="Clientes Ativos"
                        Valor="{Binding TotalClientesAtivos, StringFormat='{0}'}"
                        CorValor="{StaticResource Primary}" />

                    <controls:MetricaCardView Grid.Row="0" Grid.Column="1"
                        Titulo="Aplicações Ativas"
                        Valor="{Binding TotalAplicacoesAtivas, StringFormat='{0}'}"
                        CorValor="{StaticResource Primary}" />

                    <controls:MetricaCardView Grid.Row="1" Grid.Column="0"
                        Titulo="Licenças Ativas"
                        Valor="{Binding TotalLicencasAtivas, StringFormat='{0}'}"
                        CorValor="{StaticResource Success}" />

                    <controls:MetricaCardView Grid.Row="1" Grid.Column="1"
                        Titulo="Licenças Inativas"
                        Valor="{Binding TotalLicencasInativas, StringFormat='{0}'}"
                        CorValor="{StaticResource TextSecondary}" />

                    <controls:MetricaCardView Grid.Row="2" Grid.Column="0"
                        Titulo="Sessões Agora"
                        Valor="{Binding SessoesAtivasAgora, StringFormat='{0}'}"
                        CorValor="{StaticResource Info}" />

                    <controls:MetricaCardView Grid.Row="2" Grid.Column="1"
                        Titulo="Expirando (7d)"
                        Valor="{Binding LicencasExpirandoEm7Dias, StringFormat='{0}'}"
                        CorValor="{StaticResource Warning}" />

                    <controls:MetricaCardView Grid.Row="3" Grid.Column="0"
                        Titulo="Novas Licenças (30d)"
                        Valor="{Binding NovasLicencas30Dias, StringFormat='{0}'}"
                        CorValor="{StaticResource Primary}" />

                    <controls:MetricaCardView Grid.Row="3" Grid.Column="1"
                        Titulo="Novos Clientes (30d)"
                        Valor="{Binding NovosClientes30Dias, StringFormat='{0}'}"
                        CorValor="{StaticResource Primary}" />
                </Grid>

                <!-- ── Licenças por tipo ── -->
                <Label Text="Licenças por Tipo" Style="{StaticResource LabelSecao}" />

                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto"
                      ColumnSpacing="8" RowSpacing="8">

                    <controls:MetricaCardView Grid.Row="0" Grid.Column="0"
                        Titulo="Permanente"
                        Valor="{Binding LicencasPermanente, StringFormat='{0}'}" />

                    <controls:MetricaCardView Grid.Row="0" Grid.Column="1"
                        Titulo="Por Período"
                        Valor="{Binding LicencasPorPeriodo, StringFormat='{0}'}" />

                    <controls:MetricaCardView Grid.Row="1" Grid.Column="0"
                        Titulo="Por Usuários"
                        Valor="{Binding LicencasPorUsuarios, StringFormat='{0}'}" />

                    <controls:MetricaCardView Grid.Row="1" Grid.Column="1"
                        Titulo="Por Instalação"
                        Valor="{Binding LicencasPorInstalacao, StringFormat='{0}'}" />
                </Grid>

                <!-- ── Alertas: Sessões inativas ── -->
                <VerticalStackLayout IsVisible="{Binding TemSessoesInativas}" Spacing="8">
                    <Label Text="⚠ Sessões Inativas" Style="{StaticResource LabelSecao}"
                           TextColor="{StaticResource Warning}" />

                    <CollectionView ItemsSource="{Binding SessoesInativas}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="dash:SessaoInativaAlerta">
                                <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                                    <Border.StrokeShape>RoundRectangle 8</Border.StrokeShape>
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="{Binding ClienteFinalRazaoSocial}"
                                               FontAttributes="Bold" FontSize="14"
                                               TextColor="{StaticResource TextPrimary}" />
                                        <Label FontSize="12" TextColor="{StaticResource TextSecondary}">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding AplicativoTitulo}" />
                                                    <Span Text=" · " />
                                                    <Span Text="{Binding IdentificadorUsuario}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                        <Label FontSize="12" TextColor="{StaticResource Warning}">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding HorasInativa, StringFormat='{0:F1}'}" />
                                                    <Span Text="h inativa" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <!-- ── Alertas: Licenças no limite ── -->
                <VerticalStackLayout IsVisible="{Binding TemLicencasNoLimite}" Spacing="8">
                    <Label Text="⚠ Licenças no Limite" Style="{StaticResource LabelSecao}"
                           TextColor="{StaticResource Danger}" />

                    <CollectionView ItemsSource="{Binding LicencasNoLimite}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="dash:LicencaLimiteAlerta">
                                <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                                    <Border.StrokeShape>RoundRectangle 8</Border.StrokeShape>
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="{Binding ClienteFinalRazaoSocial}"
                                               FontAttributes="Bold" FontSize="14"
                                               TextColor="{StaticResource TextPrimary}" />
                                        <Label FontSize="12" TextColor="{StaticResource TextSecondary}">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding AplicativoTitulo}" />
                                                    <Span Text=" · " />
                                                    <Span Text="{Binding TipoLicenca}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                        <Label FontSize="12" TextColor="{StaticResource Danger}">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding UsoAtual}" />
                                                    <Span Text=" / " />
                                                    <Span Text="{Binding Maximo}" />
                                                    <Span Text=" em uso" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <!-- ── Alertas: Erros de validação ── -->
                <Border Style="{StaticResource Card}"
                        IsVisible="{Binding TemErrosValidacao}"
                        BackgroundColor="{StaticResource DangerLight}">
                    <Border.StrokeShape>RoundRectangle 8</Border.StrokeShape>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Erros de Validação" FontAttributes="Bold"
                               TextColor="{StaticResource Danger}" />
                        <Label TextColor="{StaticResource Danger}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{Binding TotalErrosValidacao}" FontAttributes="Bold" />
                                    <Span Text=" erros nas últimas 24h" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
