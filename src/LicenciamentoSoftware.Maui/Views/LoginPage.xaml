<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LicenciamentoSoftware.Maui.ViewModels"
             x:Class="LicenciamentoSoftware.Maui.Views.LoginPage"
             x:DataType="vm:LoginViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource Background}">

    <ScrollView>
        <VerticalStackLayout Padding="32,48" Spacing="0">

            <!-- Logo / Brand -->
            <Border Style="{StaticResource Card}"
                    BackgroundColor="{StaticResource Primary}"
                    WidthRequest="64" HeightRequest="64"
                    HorizontalOptions="Center"
                    Margin="0,0,0,16">
                <Border.StrokeShape>RoundRectangle 12</Border.StrokeShape>
                <Label Text="LS" FontSize="22" FontAttributes="Bold"
                       TextColor="White" HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </Border>

            <Label Text="LicenseManager" FontSize="20" FontAttributes="Bold"
                   TextColor="{StaticResource TextPrimary}"
                   HorizontalOptions="Center" Margin="0,0,0,4" />

            <Label Text="Sistema de Licenças" FontSize="13"
                   TextColor="{StaticResource TextSecondary}"
                   HorizontalOptions="Center" Margin="0,0,0,40" />

            <!-- Formulário -->
            <Label Text="E-mail" Style="{StaticResource LabelCampo}" />
            <Border Style="{StaticResource Card}" Padding="12,0" Margin="0,0,0,16">
                <Border.StrokeShape>RoundRectangle 8</Border.StrokeShape>
                <Entry Style="{StaticResource CampoTexto}"
                       Text="{Binding Email}"
                       Keyboard="Email"
                       Placeholder="seu@email.com"
                       ReturnType="Next" />
            </Border>

            <Label Text="Senha" Style="{StaticResource LabelCampo}" />
            <Border Style="{StaticResource Card}" Padding="12,0" Margin="0,0,0,8">
                <Border.StrokeShape>RoundRectangle 8</Border.StrokeShape>
                <Entry Style="{StaticResource CampoTexto}"
                       Text="{Binding Senha}"
                       IsPassword="True"
                       Placeholder="••••••••"
                       ReturnType="Go"
                       ReturnCommand="{Binding LoginCommand}" />
            </Border>

            <!-- Erro -->
            <Label Text="{Binding Erro}"
                   Style="{StaticResource LabelErro}"
                   IsVisible="{Binding Erro, Converter={StaticResource StringNotNullConverter}}"
                   Margin="0,4,0,8" />

            <!-- Botão Entrar -->
            <Button Text="Entrar"
                    Style="{StaticResource BotaoPrimario}"
                    Command="{Binding LoginCommand}"
                    IsEnabled="{Binding NaoOcupado}"
                    Margin="0,8,0,0" />

            <ActivityIndicator IsRunning="{Binding Ocupado}"
                               IsVisible="{Binding Ocupado}"
                               Margin="0,8,0,0" />

            <!-- Separador -->
            <BoxView HeightRequest="1" BackgroundColor="{StaticResource Border}"
                     Margin="0,24,0,16" />

            <!-- Link cadastro -->
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="4">
                <Label Text="Ainda não tem conta?"
                       TextColor="{StaticResource TextSecondary}" FontSize="14" />
                <Label Text="Cadastre-se"
                       TextColor="{StaticResource Primary}"
                       FontAttributes="Bold" FontSize="14">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding IrParaCadastroCommand}" />
                    </Label.GestureRecognizers>
                </Label>
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
