<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LicenciamentoSoftware.Maui.ViewModels.MinhaConta"
             x:Class="LicenciamentoSoftware.Maui.Views.MinhaConta.MinhaContaPage"
             x:DataType="vm:MinhaContaViewModel"
             Title="{Binding Titulo}">

    <ScrollView>
        <VerticalStackLayout Padding="20,16" Spacing="0">

            <!-- ── Autenticação 2FA ──────────────────────────────────────── -->
            <Border BackgroundColor="{StaticResource Surface}"
                    Stroke="{StaticResource Border}" StrokeThickness="1"
                    Padding="20,16" Margin="0,0,0,16">
                <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Autenticação de dois fatores"
                               FontSize="16" FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}" VerticalOptions="Center" />
                        <Border Grid.Column="1" Padding="10,4" StrokeThickness="1"
                                IsVisible="{Binding TotpAtivo, Converter={StaticResource StringNotNullConverter}}">
                            <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding TotpAtivo}" Value="True">
                                    <Setter Property="BackgroundColor" Value="#d1fae5" />
                                    <Setter Property="Stroke" Value="#10b981" />
                                </DataTrigger>
                                <DataTrigger TargetType="Border" Binding="{Binding TotpAtivo}" Value="False">
                                    <Setter Property="BackgroundColor" Value="{StaticResource DangerLight}" />
                                    <Setter Property="Stroke" Value="{StaticResource Danger}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Label FontSize="11" FontAttributes="Bold">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding TotpAtivo}" Value="True">
                                        <Setter Property="Text" Value="Ativo" />
                                        <Setter Property="TextColor" Value="#065f46" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Label" Binding="{Binding TotpAtivo}" Value="False">
                                        <Setter Property="Text" Value="Inativo" />
                                        <Setter Property="TextColor" Value="{StaticResource Danger}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </Border>
                    </Grid>
                    <BoxView HeightRequest="1" BackgroundColor="{StaticResource Border}" Margin="0,0,0,4" />
                    <Label Text="Adiciona uma camada extra de segurança ao seu login."
                           FontSize="13" TextColor="{StaticResource TextSecondary}" />

                    <!-- Mensagens 2FA -->
                    <Border IsVisible="{Binding ErroTotp, Converter={StaticResource StringNotNullConverter}}"
                            BackgroundColor="{StaticResource DangerLight}" Stroke="{StaticResource Danger}"
                            StrokeThickness="1" Padding="10,8">
                        <Border.StrokeShape><RoundRectangle CornerRadius="6" /></Border.StrokeShape>
                        <Label Text="{Binding ErroTotp}" TextColor="{StaticResource Danger}" FontSize="13" />
                    </Border>
                    <Border IsVisible="{Binding SucessoTotp, Converter={StaticResource StringNotNullConverter}}"
                            BackgroundColor="#d1fae5" Stroke="#10b981" StrokeThickness="1" Padding="10,8">
                        <Border.StrokeShape><RoundRectangle CornerRadius="6" /></Border.StrokeShape>
                        <Label Text="{Binding SucessoTotp}" TextColor="#065f46" FontSize="13" />
                    </Border>

                    <!-- Botão Ativar 2FA -->
                    <Button Text="Ativar 2FA"
                            BackgroundColor="{StaticResource Primary}" TextColor="White"
                            CornerRadius="8" HeightRequest="44"
                            Command="{Binding IniciarSetup2FACommand}"
                            IsEnabled="{Binding NaoOcupado}"
                            IsVisible="False">
                        <Button.Triggers>
                            <MultiTrigger TargetType="Button">
                                <MultiTrigger.Conditions>
                                    <BindingCondition Binding="{Binding TotpAtivo}" Value="False" />
                                    <BindingCondition Binding="{Binding ExibirSetup2FA}" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter Property="IsVisible" Value="True" />
                            </MultiTrigger>
                        </Button.Triggers>
                    </Button>

                    <!-- Botão Desativar 2FA -->
                    <Button Text="Desativar 2FA"
                            BackgroundColor="Transparent" TextColor="{StaticResource Danger}"
                            BorderColor="{StaticResource Danger}" BorderWidth="1"
                            CornerRadius="8" HeightRequest="44"
                            Command="{Binding MostrarDesativar2FACommand}"
                            IsEnabled="{Binding NaoOcupado}"
                            IsVisible="False">
                        <Button.Triggers>
                            <MultiTrigger TargetType="Button">
                                <MultiTrigger.Conditions>
                                    <BindingCondition Binding="{Binding TotpAtivo}" Value="True" />
                                    <BindingCondition Binding="{Binding ExibirDesativar2FA}" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter Property="IsVisible" Value="True" />
                            </MultiTrigger>
                        </Button.Triggers>
                    </Button>

                    <!-- Setup 2FA inline -->
                    <VerticalStackLayout IsVisible="{Binding ExibirSetup2FA}" Spacing="10"
                                         BackgroundColor="#f8f9fa" Padding="12">
                        <Label Text="Passo 1: Copie o código e adicione manualmente no Google Authenticator ou Authy."
                               FontSize="13" TextColor="{StaticResource TextSecondary}" />
                        <Border BackgroundColor="#1a1a2e" Stroke="{StaticResource Border}"
                                StrokeThickness="1" Padding="12,10">
                            <Border.StrokeShape><RoundRectangle CornerRadius="6" /></Border.StrokeShape>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <Label Grid.Column="0" Text="{Binding SegredoTotp}"
                                       FontSize="13" TextColor="#00ff88"
                                       VerticalOptions="Center" LineBreakMode="WordWrap" />
                                <Button Grid.Column="1" Text="Copiar"
                                        BackgroundColor="{StaticResource Primary}" TextColor="White"
                                        CornerRadius="6" HeightRequest="36" Padding="12,0"
                                        Command="{Binding CopiarSegredoCommand}" />
                            </Grid>
                        </Border>
                        <Label Text="Passo 2: Digite o código gerado pelo autenticador para confirmar."
                               FontSize="13" TextColor="{StaticResource TextSecondary}" />
                        <Border BackgroundColor="{StaticResource Surface}"
                                Stroke="{StaticResource Border}" StrokeThickness="1" Padding="12,0">
                            <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                            <Entry Text="{Binding CodigoConfirmacaoTotp}"
                                   Placeholder="000000" MaxLength="6" Keyboard="Numeric"
                                   HorizontalTextAlignment="Center" FontSize="18"
                                   TextColor="{StaticResource TextPrimary}" HeightRequest="52" />
                        </Border>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Button Grid.Column="0" Text="Cancelar"
                                    BackgroundColor="{StaticResource Surface}"
                                    TextColor="{StaticResource TextPrimary}"
                                    BorderColor="{StaticResource Border}" BorderWidth="1"
                                    CornerRadius="8" HeightRequest="44"
                                    Command="{Binding CancelarSetup2FACommand}" />
                            <Button Grid.Column="1" Text="Confirmar"
                                    BackgroundColor="{StaticResource Primary}" TextColor="White"
                                    CornerRadius="8" HeightRequest="44" FontAttributes="Bold"
                                    Command="{Binding ConfirmarSetup2FACommand}"
                                    IsEnabled="{Binding NaoOcupado}" />
                        </Grid>
                    </VerticalStackLayout>

                    <!-- Desativar 2FA inline -->
                    <VerticalStackLayout IsVisible="{Binding ExibirDesativar2FA}" Spacing="10"
                                         BackgroundColor="#fff8e1" Padding="12">
                        <Label Text="Digite o código do autenticador para confirmar a desativação."
                               FontSize="13" TextColor="#856404" />
                        <Border BackgroundColor="{StaticResource Surface}"
                                Stroke="{StaticResource Border}" StrokeThickness="1" Padding="12,0">
                            <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                            <Entry Text="{Binding CodigoDesativarTotp}"
                                   Placeholder="000000" MaxLength="6" Keyboard="Numeric"
                                   HorizontalTextAlignment="Center" FontSize="18"
                                   TextColor="{StaticResource TextPrimary}" HeightRequest="52" />
                        </Border>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Button Grid.Column="0" Text="Cancelar"
                                    BackgroundColor="{StaticResource Surface}"
                                    TextColor="{StaticResource TextPrimary}"
                                    BorderColor="{StaticResource Border}" BorderWidth="1"
                                    CornerRadius="8" HeightRequest="44"
                                    Command="{Binding CancelarDesativar2FACommand}" />
                            <Button Grid.Column="1" Text="Desativar"
                                    BackgroundColor="{StaticResource Danger}" TextColor="White"
                                    CornerRadius="8" HeightRequest="44" FontAttributes="Bold"
                                    Command="{Binding ConfirmarDesativar2FACommand}"
                                    IsEnabled="{Binding NaoOcupado}" />
                        </Grid>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- ── Alterar senha ─────────────────────────────────────────── -->
            <Border BackgroundColor="{StaticResource Surface}"
                    Stroke="{StaticResource Border}" StrokeThickness="1"
                    Padding="20,16" Margin="0,0,0,24">
                <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                <VerticalStackLayout Spacing="12">
                    <Label Text="Alterar senha"
                           FontSize="16" FontAttributes="Bold"
                           TextColor="{StaticResource TextPrimary}" />
                    <BoxView HeightRequest="1" BackgroundColor="{StaticResource Border}" Margin="0,0,0,4" />
                    <Label Text="Escolha uma senha segura com pelo menos 8 caracteres."
                           FontSize="13" TextColor="{StaticResource TextSecondary}" />

                    <Label Text="Senha atual *" Style="{StaticResource LabelCampo}" />
                    <Border BackgroundColor="{StaticResource Surface}"
                            Stroke="{StaticResource Border}" StrokeThickness="1" Padding="12,0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                        <Entry Text="{Binding SenhaAtual}" IsPassword="True"
                               Placeholder="••••••••"
                               TextColor="{StaticResource TextPrimary}" FontSize="14" HeightRequest="44" />
                    </Border>

                    <Label Text="Nova senha *" Style="{StaticResource LabelCampo}" />
                    <Border BackgroundColor="{StaticResource Surface}"
                            Stroke="{StaticResource Border}" StrokeThickness="1" Padding="12,0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                        <Entry Text="{Binding NovaSenha}" IsPassword="True"
                               Placeholder="Mínimo 8 caracteres"
                               TextColor="{StaticResource TextPrimary}" FontSize="14" HeightRequest="44" />
                    </Border>

                    <Label Text="Confirmar nova senha *" Style="{StaticResource LabelCampo}" />
                    <Border BackgroundColor="{StaticResource Surface}"
                            Stroke="{StaticResource Border}" StrokeThickness="1" Padding="12,0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                        <Entry Text="{Binding ConfirmacaoSenha}" IsPassword="True"
                               Placeholder="Repita a nova senha"
                               TextColor="{StaticResource TextPrimary}" FontSize="14" HeightRequest="44" />
                    </Border>

                    <Border IsVisible="{Binding ErroSenha, Converter={StaticResource StringNotNullConverter}}"
                            BackgroundColor="{StaticResource DangerLight}" Stroke="{StaticResource Danger}"
                            StrokeThickness="1" Padding="10,8">
                        <Border.StrokeShape><RoundRectangle CornerRadius="6" /></Border.StrokeShape>
                        <Label Text="{Binding ErroSenha}" TextColor="{StaticResource Danger}" FontSize="13" />
                    </Border>
                    <Border IsVisible="{Binding SucessoSenha}"
                            BackgroundColor="#d1fae5" Stroke="#10b981" StrokeThickness="1" Padding="10,8">
                        <Border.StrokeShape><RoundRectangle CornerRadius="6" /></Border.StrokeShape>
                        <Label Text="Senha alterada com sucesso." TextColor="#065f46" FontSize="13" />
                    </Border>

                    <Button Text="Alterar senha"
                            BackgroundColor="{StaticResource Primary}" TextColor="White"
                            CornerRadius="8" HeightRequest="44" FontAttributes="Bold"
                            Command="{Binding AlterarSenhaCommand}"
                            IsEnabled="{Binding NaoOcupado}" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
