<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LicenciamentoSoftware.Maui.ViewModels.MinhaEmpresa"
             x:Class="LicenciamentoSoftware.Maui.Views.MinhaEmpresa.MinhaEmpresaPage"
             x:DataType="vm:MinhaEmpresaViewModel"
             Title="{Binding Titulo}">

    <Grid RowDefinitions="*,Auto">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="20,16" Spacing="0">

                <!-- ── Dados da empresa ─────────────────────────────────── -->
                <Border BackgroundColor="{StaticResource Surface}"
                        Stroke="{StaticResource Border}" StrokeThickness="1"
                        Padding="20,16" Margin="0,0,0,16">
                    <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Dados cadastrais"
                               FontSize="16" FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}" />
                        <BoxView HeightRequest="1" BackgroundColor="{StaticResource Border}" Margin="0,0,0,4" />

                        <Label Text="Razão Social *" Style="{StaticResource LabelCampo}" />
                        <Border BackgroundColor="{StaticResource Surface}"
                                Stroke="{StaticResource Border}" StrokeThickness="1" Padding="12,0">
                            <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                            <Entry Text="{Binding FormRazaoSocial}" Placeholder="Razão social"
                                   TextColor="{StaticResource TextPrimary}" FontSize="14" HeightRequest="44" />
                        </Border>

                        <Label Text="E-mail *" Style="{StaticResource LabelCampo}" />
                        <Border BackgroundColor="{StaticResource Surface}"
                                Stroke="{StaticResource Border}" StrokeThickness="1" Padding="12,0">
                            <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                            <Entry Text="{Binding FormEmail}" Keyboard="Email"
                                   TextColor="{StaticResource TextPrimary}" FontSize="14" HeightRequest="44" />
                        </Border>

                        <Label Text="Telefone" Style="{StaticResource LabelCampo}" />
                        <Border BackgroundColor="{StaticResource Surface}"
                                Stroke="{StaticResource Border}" StrokeThickness="1" Padding="12,0">
                            <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                            <Entry Text="{Binding FormTelefone}" Keyboard="Telephone"
                                   Placeholder="(00) 00000-0000"
                                   TextColor="{StaticResource TextPrimary}" FontSize="14" HeightRequest="44" />
                        </Border>

                        <Border IsVisible="{Binding ErroSalvar, Converter={StaticResource StringNotNullConverter}}"
                                BackgroundColor="{StaticResource DangerLight}" Stroke="{StaticResource Danger}"
                                StrokeThickness="1" Padding="10,8">
                            <Border.StrokeShape><RoundRectangle CornerRadius="6" /></Border.StrokeShape>
                            <Label Text="{Binding ErroSalvar}" TextColor="{StaticResource Danger}" FontSize="13" />
                        </Border>
                        <Border IsVisible="{Binding SucessoSalvar}"
                                BackgroundColor="#d1fae5" Stroke="#10b981" StrokeThickness="1" Padding="10,8">
                            <Border.StrokeShape><RoundRectangle CornerRadius="6" /></Border.StrokeShape>
                            <Label Text="Dados atualizados com sucesso." TextColor="#065f46" FontSize="13" />
                        </Border>

                        <Button Text="Salvar alterações"
                                BackgroundColor="{StaticResource Primary}" TextColor="White"
                                CornerRadius="8" HeightRequest="44" FontAttributes="Bold"
                                Command="{Binding SalvarEmpresaCommand}"
                                IsEnabled="{Binding NaoOcupado}" />
                    </VerticalStackLayout>
                </Border>

                <!-- ── Zona de perigo — Encerrar conta ──────────────────── -->
                <Border Stroke="{StaticResource Danger}" StrokeThickness="1"
                        BackgroundColor="{StaticResource Surface}"
                        Padding="20,16" Margin="0,0,0,24">
                    <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Encerrar conta" FontSize="16" FontAttributes="Bold"
                               TextColor="{StaticResource Danger}" />
                        <Label Text="Encerrando a conta, todos os acessos são bloqueados imediatamente. Os dados serão excluídos em 90 dias, a menos que opte pela exclusão imediata."
                               FontSize="13" TextColor="{StaticResource TextSecondary}" />
                        <Button Text="Encerrar conta da empresa"
                                BackgroundColor="Transparent" TextColor="{StaticResource Danger}"
                                BorderColor="{StaticResource Danger}" BorderWidth="1"
                                CornerRadius="8" HeightRequest="44"
                                Command="{Binding AbrirModalEncerrarCommand}" />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- ── Overlay: modal de encerramento ──────────────────────────── -->
        <Grid Grid.RowSpan="2" IsVisible="{Binding ExibirModalEncerrar}" BackgroundColor="#88000000">
            <Border BackgroundColor="{StaticResource Surface}"
                    Stroke="{StaticResource Border}" StrokeThickness="1"
                    Margin="24" Padding="24,20"
                    VerticalOptions="Center" MaximumWidthRequest="480"
                    HorizontalOptions="Center">
                <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#000000" Offset="0,8" Radius="24" Opacity="0.15" />
                </Border.Shadow>
                <ScrollView>
                    <VerticalStackLayout Spacing="14">
                        <Label Text="Encerrar conta da empresa"
                               FontSize="18" FontAttributes="Bold"
                               TextColor="{StaticResource Danger}" />
                        <BoxView HeightRequest="1" BackgroundColor="{StaticResource Border}" Margin="0,0,0,4" />

                        <Label FontSize="13" TextColor="{StaticResource TextSecondary}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Esta ação encerrará a conta de " />
                                    <Span Text="{Binding Empresa.RazaoSocial}" FontAttributes="Bold"
                                          TextColor="{StaticResource TextPrimary}" />
                                    <Span Text=" e bloqueará todos os acessos imediatamente." />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>

                        <Label Text="Confirme sua senha *" Style="{StaticResource LabelCampo}" />
                        <Border BackgroundColor="{StaticResource Surface}"
                                Stroke="{StaticResource Border}" StrokeThickness="1" Padding="12,0">
                            <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                            <Entry Text="{Binding SenhaConfirmacao}" IsPassword="True"
                                   Placeholder="••••••••"
                                   TextColor="{StaticResource TextPrimary}" FontSize="14" HeightRequest="44" />
                        </Border>

                        <!-- Checkbox exclusão imediata -->
                        <HorizontalStackLayout Spacing="10">
                            <CheckBox IsChecked="{Binding ExclusaoImediata}"
                                      Color="{StaticResource Danger}" />
                            <Label Text="Excluir todos os dados imediatamente"
                                   FontSize="14" TextColor="{StaticResource TextPrimary}"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>

                        <!-- Aviso quando exclusão imediata marcada -->
                        <Border IsVisible="{Binding ExclusaoImediata}"
                                BackgroundColor="#fff8e1" Stroke="#ffc107" StrokeThickness="1" Padding="12,10">
                            <Border.StrokeShape><RoundRectangle CornerRadius="6" /></Border.StrokeShape>
                            <Label Text="⚠️ Seus dados serão excluídos permanentemente na próxima limpeza automática (em até 24h). Esta ação é irreversível."
                                   FontSize="12" TextColor="#856404" />
                        </Border>
                        <Label IsVisible="{Binding ExclusaoImediata, Converter={StaticResource InverseBoolConverter}}"
                               Text="Se não marcado, os dados serão excluídos em 90 dias."
                               FontSize="12" TextColor="{StaticResource TextSecondary}" />

                        <!-- Erro -->
                        <Border IsVisible="{Binding ErroEncerrar, Converter={StaticResource StringNotNullConverter}}"
                                BackgroundColor="{StaticResource DangerLight}" Stroke="{StaticResource Danger}"
                                StrokeThickness="1" Padding="10,8">
                            <Border.StrokeShape><RoundRectangle CornerRadius="6" /></Border.StrokeShape>
                            <Label Text="{Binding ErroEncerrar}" TextColor="{StaticResource Danger}" FontSize="13" />
                        </Border>

                        <!-- Botões -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,4,0,0">
                            <Button Grid.Column="0" Text="Cancelar"
                                    BackgroundColor="{StaticResource Surface}"
                                    TextColor="{StaticResource TextPrimary}"
                                    BorderColor="{StaticResource Border}" BorderWidth="1"
                                    CornerRadius="8" HeightRequest="44"
                                    Command="{Binding FecharModalEncerrarCommand}" />
                            <Button Grid.Column="1"
                                    BackgroundColor="{StaticResource Danger}" TextColor="White"
                                    CornerRadius="8" HeightRequest="44" FontAttributes="Bold"
                                    Command="{Binding ConfirmarEncerrarCommand}"
                                    IsEnabled="{Binding NaoOcupado}">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding ExclusaoImediata}" Value="True">
                                        <Setter Property="Text" Value="Encerrar e excluir" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Button" Binding="{Binding ExclusaoImediata}" Value="False">
                                        <Setter Property="Text" Value="Encerrar conta" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                        </Grid>
                    </VerticalStackLayout>
                </ScrollView>
            </Border>
        </Grid>

    </Grid>
</ContentPage>
