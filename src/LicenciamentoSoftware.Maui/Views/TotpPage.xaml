<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LicenciamentoSoftware.Maui.ViewModels"
             x:Class="LicenciamentoSoftware.Maui.Views.TotpPage"
             x:DataType="vm:TotpViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource Background}">

    <Grid>
        <ScrollView HorizontalOptions="Center"
                    VerticalOptions="Center"
                    MaximumWidthRequest="420">

            <Border Style="{StaticResource Card}"
                    Margin="24"
                    Padding="32,40">
                <Border.StrokeShape>RoundRectangle 16</Border.StrokeShape>

                <VerticalStackLayout Spacing="0">

                    <!-- Ícone -->
                    <Border BackgroundColor="{StaticResource Primary}"
                            WidthRequest="56" HeightRequest="56"
                            HorizontalOptions="Center"
                            Margin="0,0,0,16">
                        <Border.StrokeShape>RoundRectangle 12</Border.StrokeShape>
                        <Label Text="2FA" FontSize="16" FontAttributes="Bold"
                               TextColor="White"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>

                    <Label Text="Verificação em dois fatores"
                           FontSize="20" FontAttributes="Bold"
                           TextColor="{StaticResource TextPrimary}"
                           HorizontalOptions="Center"
                           Margin="0,0,0,8" />

                    <Label Text="Digite o código de 6 dígitos do seu autenticador."
                           FontSize="13"
                           TextColor="{StaticResource TextSecondary}"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"
                           Margin="0,0,0,32" />

                    <!-- Input do código -->
                    <Border Style="{StaticResource Card}"
                            Padding="12,0"
                            Margin="0,0,0,8">
                        <Border.StrokeShape>RoundRectangle 8</Border.StrokeShape>
                        <Entry Style="{StaticResource CampoTexto}"
                               Text="{Binding Codigo}"
                               Keyboard="Numeric"
                               MaxLength="6"
                               Placeholder="000000"
                               HorizontalTextAlignment="Center"
                               FontSize="28"
                               ReturnType="Go"
                               ReturnCommand="{Binding VerificarCommand}" />
                    </Border>

                    <Label Text="{Binding Erro}"
                           Style="{StaticResource LabelErro}"
                           IsVisible="{Binding Erro, Converter={StaticResource StringNotNullConverter}}"
                           HorizontalOptions="Center"
                           Margin="0,4,0,8" />

                    <Button Text="Verificar"
                            Style="{StaticResource BotaoPrimario}"
                            Command="{Binding VerificarCommand}"
                            IsEnabled="{Binding NaoOcupado}"
                            Margin="0,8,0,0" />

                    <ActivityIndicator IsRunning="{Binding Ocupado}"
                                       IsVisible="{Binding Ocupado}"
                                       Color="{StaticResource Primary}"
                                       Margin="0,12,0,0" />

                    <Label Text="Voltar ao login"
                           TextColor="{StaticResource Primary}"
                           FontSize="14"
                           HorizontalOptions="Center"
                           Margin="0,24,0,0">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding VoltarCommand}" />
                        </Label.GestureRecognizers>
                    </Label>

                </VerticalStackLayout>
            </Border>
        </ScrollView>
    </Grid>
</ContentPage>
