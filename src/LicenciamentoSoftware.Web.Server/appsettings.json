{
  "ApiSettings": {
    "BaseUrl": "https://localhost:7075"
  },
  "ReverseProxy": {
    "Routes": {
      "api-route": {
        "ClusterId": "api-cluster",
        "Match": { "Path": "/api/{**catch-all}" },
        "Transforms": [ { "RequestHeadersCopy": "true" }, { "RequestHeader": "Authorization", "Set": "" } ]
      },
      "auth-route": {
        "ClusterId": "api-cluster",
        "Match": { "Path": "/auth/{**catch-all}" },
        "Transforms": [ { "RequestHeadersCopy": "true" } ]
      },
      "clientes-finais-route": {
        "ClusterId": "api-cluster",
        "Match": { "Path": "/clientes-finais/{**catch-all}" },
        "Transforms": [ { "RequestHeadersCopy": "true" } ]
      },
      "clientes-route": {
        "ClusterId": "api-cluster",
        "Match": { "Path": "/clientes/{**catch-all}" },
        "Transforms": [ { "RequestHeadersCopy": "true" } ]
      },
      "usuarios-route": {
        "ClusterId": "api-cluster",
        "Match": { "Path": "/usuarios/{**catch-all}" },
        "Transforms": [ { "RequestHeadersCopy": "true" } ]
      },
      "aplicacoes-route": {
        "ClusterId": "api-cluster",
        "Match": { "Path": "/aplicacoes/{**catch-all}" },
        "Transforms": [ { "RequestHeadersCopy": "true" } ]
      },
      "tipos-licenca-route": {
        "ClusterId": "api-cluster",
        "Match": { "Path": "/tipos-licenca/{**catch-all}" },
        "Transforms": [ { "RequestHeadersCopy": "true" } ]
      },
      "licencas-route": {
        "ClusterId": "api-cluster",
        "Match": { "Path": "/licencas/{**catch-all}" },
        "Transforms": [ { "RequestHeadersCopy": "true" } ]
      },
      "validacao-route": {
        "ClusterId": "api-cluster",
        "Match": { "Path": "/validacao/{**catch-all}" },
        "Transforms": [ { "RequestHeadersCopy": "true" } ]
      },
      "health-route": {
        "ClusterId": "api-cluster",
        "Match": { "Path": "/health" },
        "Transforms": [ { "RequestHeadersCopy": "true" } ]
      }
    },
    "Clusters": {
      "api-cluster": {
        "Destinations": {
          "api": {
            "Address": "https://localhost:7075/"
          }
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
