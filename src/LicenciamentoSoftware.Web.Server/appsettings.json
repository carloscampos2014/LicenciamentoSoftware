{
  "ApiSettings": {
    "BaseUrl": "https://localhost:7075"
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "api-cluster",
        "Match": {
          "Path": "/auth/{**catch-all}",
          "Headers": [{ "Name": "Authorization", "Mode": "Exists" }]
        }
      },
      "auth-public-route": {
        "ClusterId": "api-cluster",
        "Match": { "Path": "/auth/{action}" }
      },
      "clientes-finais-route": {
        "ClusterId": "api-cluster",
        "Match": {
          "Path": "/clientes-finais/{**catch-all}",
          "Headers": [{ "Name": "Authorization", "Mode": "Exists" }]
        }
      },
      "clientes-route": {
        "ClusterId": "api-cluster",
        "Match": {
          "Path": "/clientes/{**catch-all}",
          "Headers": [{ "Name": "Authorization", "Mode": "Exists" }]
        }
      },
      "usuarios-route": {
        "ClusterId": "api-cluster",
        "Match": {
          "Path": "/usuarios/{**catch-all}",
          "Headers": [{ "Name": "Authorization", "Mode": "Exists" }]
        }
      },
      "aplicacoes-route": {
        "ClusterId": "api-cluster",
        "Match": {
          "Path": "/aplicacoes/{**catch-all}",
          "Headers": [{ "Name": "Authorization", "Mode": "Exists" }]
        }
      },
      "tipos-licenca-route": {
        "ClusterId": "api-cluster",
        "Match": {
          "Path": "/tipos-licenca/{**catch-all}",
          "Headers": [{ "Name": "Authorization", "Mode": "Exists" }]
        }
      },
      "licencas-route": {
        "ClusterId": "api-cluster",
        "Match": {
          "Path": "/licencas/{**catch-all}",
          "Headers": [{ "Name": "Authorization", "Mode": "Exists" }]
        }
      },
      "validacao-route": {
        "ClusterId": "api-cluster",
        "Match": { "Path": "/validacao/{**catch-all}" }
      },
      "dashboard-route": {
        "ClusterId": "api-cluster",
        "Match": {
          "Path": "/dashboard/{subrota}/{**catch-all}",
          "Headers": [{ "Name": "Authorization", "Mode": "Exists" }]
        }
      },
      "health-route": {
        "ClusterId": "api-cluster",
        "Match": { "Path": "/health" }
      }
    },
    "Clusters": {
      "api-cluster": {
        "Destinations": {
          "api": {
            "Address": "https://localhost:7075/"
          }
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
