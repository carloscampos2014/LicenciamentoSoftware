@inherits LayoutComponentBase
@inject JwtAuthStateProvider Auth
@inject NavigationManager Nav

<div class="app-shell">
    <AuthorizeView>
        <Authorized>
            <!-- Topbar mobile — só visível em telas pequenas -->
            <header class="mobile-topbar">
                <button class="hamburger-btn" @onclick="ToggleSidebar" aria-label="Abrir menu">
                    @if (_sidebarAberta)
                    {
                        <!-- X para fechar -->
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="18" y1="6" x2="6" y2="18"/>
                            <line x1="6" y1="6" x2="18" y2="18"/>
                        </svg>
                    }
                    else
                    {
                        <!-- Hamburguer -->
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="3" y1="6" x2="21" y2="6"/>
                            <line x1="3" y1="12" x2="21" y2="12"/>
                            <line x1="3" y1="18" x2="21" y2="18"/>
                        </svg>
                    }
                </button>
                <div class="mobile-topbar-brand">
                    <div class="sidebar-brand-icon" style="width:32px;height:32px;font-size:.8rem">LS</div>
                    <span style="font-weight:700;font-size:.95rem;margin-left:.5rem">LicenseManager</span>
                </div>
            </header>

            <!-- Backdrop — fecha a sidebar ao clicar fora -->
            @if (_sidebarAberta)
            {
                <div class="sidebar-backdrop" @onclick="FecharSidebar"></div>
            }

            <NavMenu NomeUsuario="@Auth.ObterNome()"
                     Aberta="_sidebarAberta"
                     OnFechar="FecharSidebar" />
        </Authorized>
    </AuthorizeView>

    <main class="main-content">
        @Body
    </main>
</div>

@code {
    private bool _sidebarAberta;

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        _sidebarAberta = false;
        InvokeAsync(StateHasChanged);
    }

    private void ToggleSidebar() => _sidebarAberta = !_sidebarAberta;
    private void FecharSidebar() => _sidebarAberta = false;

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
    }
}
