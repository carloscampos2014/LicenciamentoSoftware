@inject NavigationManager Nav

<nav class="d-flex flex-column bg-dark text-white p-3" style="width:240px;min-height:100vh">
    <a class="navbar-brand text-white fw-bold mb-4" href="/">Licenciamento</a>

    <ul class="nav flex-column gap-1">
        <li class="nav-item">
            <NavLink class="nav-link text-white-50" href="/clientes-finais" Match="NavLinkMatch.Prefix">
                Clientes Finais
            </NavLink>
        </li>

        <AuthorizeView Roles="AdministradorCliente,OperadorCliente">
            <Authorized>
                <li class="nav-item">
                    <NavLink class="nav-link text-white-50" href="/aplicacoes" Match="NavLinkMatch.Prefix">
                        Aplicações
                    </NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link text-white-50" href="/licencas" Match="NavLinkMatch.Prefix">
                        Licenças
                    </NavLink>
                </li>
            </Authorized>
        </AuthorizeView>

        <AuthorizeView Roles="AdministradorCliente">
            <Authorized>
                <li class="nav-item">
                    <NavLink class="nav-link text-white-50" href="/usuarios" Match="NavLinkMatch.Prefix">
                        Usuários
                    </NavLink>
                </li>
            </Authorized>
        </AuthorizeView>
    </ul>
</nav>
