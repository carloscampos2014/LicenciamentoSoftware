@page "/aplicacoes"
@attribute [Authorize]
@inject AplicacaoApiService Service
@inject TipoLicencaApiService TiposService

<PageTitle>Aplicações — Licenciamento</PageTitle>

<div class="page-header-row">
    <div class="page-header">
        <h1>Aplicações</h1>
        <p>Gerencie seus aplicativos e integrações</p>
    </div>
    <button class="btn btn-primary" @onclick="AbrirNovo">+ Nova Aplicação</button>
</div>

<div class="mb-3">
    <input class="search-bar" placeholder="Buscar por nome..."
           @bind="_filtro" @bind:event="oninput" @onkeyup="HandleFiltro" />
</div>

@if (_carregando)
{
    <div class="text-center py-5"><div class="spinner-border text-primary" role="status"></div></div>
}
else if (_erro is not null) { <ApiError Erro="@_erro" /> }
else if (_itens.Count == 0)
{
    <div class="empty-state">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                  d="M9 3H5a2 2 0 00-2 2v4m6-6h10a2 2 0 012 2v4M9 3v18m0 0h10a2 2 0 002-2V9M9 21H5a2 2 0 01-2-2V9m0 0h18"/>
        </svg>
        <p>Nenhuma aplicação encontrada.</p>
    </div>
}
else
{
    <div class="cards-grid">
        @foreach (var item in _itens)
        {
            <div class="item-card">
                <div class="item-card-header">
                    <div>
                        <p class="item-card-title">@item.Titulo</p>
                        <div class="d-flex gap-1 mt-1">
                            <span class="badge-pill @(item.Ativo ? "badge-ativo" : "badge-inativo")">
                                @(item.Ativo ? "Ativo" : "Inativo")
                            </span>
                            <span class="badge-pill @BadgeTipo(item.TipoLicencaDescricao)">
                                @item.TipoLicencaDescricao
                            </span>
                        </div>
                    </div>
                    <div class="item-card-icon" style="background:#f0eeff">
                        <svg width="18" height="18" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="#6c63ff">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M9 3H5a2 2 0 00-2 2v4m6-6h10a2 2 0 012 2v4M9 3v18m0 0h10a2 2 0 002-2V9M9 21H5a2 2 0 01-2-2V9m0 0h18"/>
                        </svg>
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(item.Descricao))
                {
                    <div class="item-card-body">
                        <p class="text-muted small mb-0">@item.Descricao</p>
                    </div>
                }
                <div class="item-card-footer">
                    <button class="btn btn-outline-secondary btn-sm" @onclick="() => AbrirEditar(item)">Editar</button>
                    @if (item.Ativo)
                    {
                        <button class="btn btn-outline-danger btn-sm" @onclick="() => Desativar(item.Id, item.Titulo)">Desativar</button>
                    }
                </div>
            </div>
        }
    </div>
    <Paginacao PaginaAtual="_pagina" TotalPaginas="_totalPaginas" Total="_total" OnPaginaMudou="MudarPagina" />
}

<Modal Visivel="_modalAberto" Titulo="@_modalTitulo" OnFechar="FecharModal">
    <ChildContent>
        <div class="form-group">
            <label class="form-label">Título *</label>
            <input class="form-control" @bind="_form.Titulo" />
        </div>
        <div class="form-group">
            <label class="form-label">Descrição</label>
            <textarea class="form-control" rows="3" @bind="_form.Descricao"></textarea>
        </div>
        @if (_editandoId is null)
        {
            <div class="form-group">
                <label class="form-label">Tipo de Licença *</label>
                <select class="form-select" @bind="_form.IdTipoLicenca">
                    @foreach (var t in _tipos)
                    {
                        <option value="@t.Id">@t.Descricao</option>
                    }
                </select>
            </div>
        }
        <ApiError Erro="@_formErro" Erros="@_formErros" />
    </ChildContent>
    <Footer>
        <button class="btn btn-outline-secondary btn-sm" @onclick="FecharModal">Cancelar</button>
        <button class="btn btn-primary btn-sm" @onclick="Salvar" disabled="@_salvando">
            @if (_salvando) { <span class="spinner-border spinner-border-sm me-1"></span> }
            Salvar
        </button>
    </Footer>
</Modal>

<ConfirmDialog @ref="_confirmDialog" Titulo="Desativar aplicação" TextoBotaoConfirmar="Desativar" />

@code {
    private List<AplicacaoResult> _itens = [];
    private IReadOnlyList<TipoLicencaResult> _tipos = [];
    private bool _carregando; private string? _erro; private string? _filtro;
    private int _pagina = 1, _totalPaginas = 1, _total;
    private ConfirmDialog _confirmDialog = default!;
    private bool _modalAberto; private string _modalTitulo = "Nova Aplicação";
    private Guid? _editandoId;
    private readonly FormModel _form = new();
    private string? _formErro; private IReadOnlyList<string>? _formErros; private bool _salvando;

    protected override async Task OnInitializedAsync()
    {
        _tipos = await TiposService.ListarAsync() ?? [];
        if (_tipos.Count > 0) _form.IdTipoLicenca = _tipos[0].Id;
        await CarregarAsync();
    }

    private async Task CarregarAsync()
    {
        _carregando = true; _erro = null;
        try
        {
            var r = await Service.ListarAsync(_filtro, pagina: _pagina);
            if (r is null) { _erro = "Erro ao carregar."; return; }
            _itens = r.Itens.ToList(); _total = r.Total; _totalPaginas = r.TotalPaginas;
        }
        catch { _erro = "Erro ao conectar com o servidor."; }
        finally { _carregando = false; }
    }

    private async Task MudarPagina(int p) { _pagina = p; await CarregarAsync(); }
    private async Task HandleFiltro(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    { if (e.Key == "Enter") { _pagina = 1; await CarregarAsync(); } }

    private void AbrirNovo()
    {
        _editandoId = null; _modalTitulo = "Nova Aplicação";
        _form.Reset(); if (_tipos.Count > 0) _form.IdTipoLicenca = _tipos[0].Id;
        _formErro = null; _formErros = null; _modalAberto = true;
    }

    private void AbrirEditar(AplicacaoResult item)
    {
        _editandoId = item.Id; _modalTitulo = "Editar Aplicação";
        _form.Titulo = item.Titulo; _form.Descricao = item.Descricao;
        _formErro = null; _formErros = null; _modalAberto = true;
    }

    private void FecharModal() => _modalAberto = false;

    private async Task Salvar()
    {
        _salvando = true; _formErro = null; _formErros = null;
        bool sucesso;
        if (_editandoId.HasValue)
        {
            var (s, _, e, erros) = await Service.AtualizarAsync(_editandoId.Value, new(_form.Titulo, _form.Descricao));
            sucesso = s; _formErro = e; _formErros = erros;
        }
        else
        {
            var (s, _, e, erros) = await Service.CriarAsync(new(_form.Titulo, _form.Descricao, _form.IdTipoLicenca));
            sucesso = s; _formErro = e; _formErros = erros;
        }
        _salvando = false;
        if (sucesso) { _modalAberto = false; await CarregarAsync(); }
    }

    private async Task Desativar(Guid id, string titulo)
    {
        _confirmDialog.Mensagem = $"Desativar \"{titulo}\"?";
        if (!await _confirmDialog.MostrarAsync()) return;
        var (sucesso, erro) = await Service.DesativarAsync(id);
        if (sucesso) await CarregarAsync();
        else _erro = erro;
    }

    private static string BadgeTipo(string tipo) => tipo switch
    {
        "Permanente"    => "badge-permanente",
        "Por Período"   => "badge-periodo",
        "Por Usuários"  => "badge-usuarios",
        "Por Instalação"=> "badge-instalacao",
        _               => "badge-inativo"
    };

    private sealed class FormModel
    {
        public string Titulo { get; set; } = string.Empty;
        public string? Descricao { get; set; }
        public Guid IdTipoLicenca { get; set; }
        public void Reset() { Titulo = string.Empty; Descricao = null; }
    }
}
