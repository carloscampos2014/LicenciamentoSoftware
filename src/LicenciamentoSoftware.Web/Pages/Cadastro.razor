@page "/cadastro"
@layout Layout.PublicLayout
@inject HttpClient Http
@inject NavigationManager Nav

<PageTitle>Cadastro — LicenseManager</PageTitle>

<div style="min-height:100vh;display:flex">
    <!-- Painel esquerdo decorativo -->
    <div class="d-none d-lg-flex flex-column justify-content-between p-5"
         style="width:420px;background:#6c63ff;flex-shrink:0">
        <div>
            <div style="width:44px;height:44px;background:rgba(255,255,255,.2);border-radius:10px;
                        display:flex;align-items:center;justify-content:center;
                        font-weight:700;font-size:1rem;color:white">
                LS
            </div>
            <div class="mt-2" style="color:white;font-weight:700;font-size:1rem">LicenseManager</div>
            <div style="color:rgba(255,255,255,.7);font-size:.75rem">Sistema de Licenças</div>
        </div>
        <div>
            <h2 style="color:white;font-size:1.75rem;font-weight:700;line-height:1.3">
                Comece a gerenciar suas licenças hoje
            </h2>
            <p style="color:rgba(255,255,255,.75);font-size:.875rem;margin-top:.75rem">
                Cadastro gratuito. Configure aplicações, emita licenças e monitore sessões em minutos.
            </p>
        </div>
        <div style="color:rgba(255,255,255,.5);font-size:.75rem">
            © 2026 LicenseManager
        </div>
    </div>

    <!-- Painel direito — formulário -->
    <div class="flex-grow-1 d-flex align-items-center justify-content-center p-4">
        <div style="width:100%;max-width:440px">

            <div class="d-lg-none text-center mb-4">
                <div class="sidebar-brand-icon mx-auto mb-2">LS</div>
                <div style="font-weight:700;font-size:1rem">LicenseManager</div>
            </div>

            @if (_sucesso)
            {
                <div class="text-center">
                    <div style="width:56px;height:56px;background:#d1fae5;border-radius:50%;
                                display:flex;align-items:center;justify-content:center;margin:0 auto 1rem">
                        <svg width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="#065f46">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                        </svg>
                    </div>
                    <h2 style="font-size:1.25rem;font-weight:700">Cadastro realizado!</h2>
                    <p class="text-muted" style="font-size:.875rem">
                        Sua conta foi criada com sucesso. Agora é só fazer login.
                    </p>
                    <a href="/login" class="btn btn-primary w-100 mt-2">Ir para o login</a>
                </div>
            }
            else
            {
                <h1 style="font-size:1.5rem;font-weight:700;color:#212529;margin-bottom:.25rem">Criar conta</h1>
                <p class="text-muted mb-4" style="font-size:.875rem">Preencha os dados da empresa e do responsável</p>

                <!-- Dados da empresa -->
                <p style="font-size:.7rem;font-weight:600;text-transform:uppercase;letter-spacing:.08em;color:#adb5bd" class="mb-2">
                    Dados da empresa
                </p>

                <div class="form-group">
                    <label class="form-label">Razão Social *</label>
                    <input class="form-control" @bind="_model.RazaoSocial" placeholder="Nome da empresa" />
                </div>

                <div class="form-grid-2">
                    <div class="form-group">
                        <label class="form-label">Tipo *</label>
                        <select class="form-select" @bind="_model.TipoInscricao">
                            <option value="1">CPF</option>
                            <option value="2">CNPJ</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label">@(_model.TipoInscricao == 1 ? "CPF" : "CNPJ") *</label>
                        <input class="form-control" @bind="_model.NumeroInscricao"
                               placeholder="@(_model.TipoInscricao == 1 ? "000.000.000-00" : "00.000.000/0001-00")" />
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label">E-mail da empresa *</label>
                    <input class="form-control" type="email" @bind="_model.EmailCliente"
                           placeholder="contato@empresa.com" />
                </div>

                <div class="form-group">
                    <label class="form-label">Telefone</label>
                    <input class="form-control" @bind="_model.Telefone" placeholder="(00) 00000-0000" />
                </div>

                <p style="font-size:.7rem;font-weight:600;text-transform:uppercase;letter-spacing:.08em;color:#adb5bd" class="mb-2 mt-3">
                    Responsável pela conta
                </p>

                <div class="form-group">
                    <label class="form-label">Nome completo *</label>
                    <input class="form-control" @bind="_model.NomeResponsavel" placeholder="Seu nome" />
                </div>

                <div class="form-group">
                    <label class="form-label">E-mail de acesso *</label>
                    <input class="form-control" type="email" @bind="_model.EmailResponsavel"
                           placeholder="responsavel@empresa.com" />
                </div>

                <div class="form-grid-2">
                    <div class="form-group">
                        <label class="form-label">Senha *</label>
                        <PasswordInput @bind-Value="_model.Senha"
                                       Placeholder="••••••••"
                                       Autocomplete="new-password"
                                       MostrarForca="true" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Confirmar senha *</label>
                        <PasswordInput @bind-Value="_model.ConfirmarSenha"
                                       Placeholder="••••••••"
                                       Autocomplete="new-password" />
                    </div>
                </div>

                @if (_erro is not null)
                {
                    <div class="alert alert-danger py-2 px-3 mb-3" style="font-size:.875rem">@_erro</div>
                }
                @if (_erros is { Count: > 0 })
                {
                    <div class="alert alert-danger py-2 px-3 mb-3" style="font-size:.875rem">
                        <ul class="mb-0 ps-3">
                            @foreach (var e in _erros) { <li>@e</li> }
                        </ul>
                    </div>
                }

                <!-- LGPD — Art. 7 e 8: consentimento obrigatório -->
                <div class="form-group mb-3">
                    <div class="d-flex align-items-start gap-2">
                        <input type="checkbox" id="lgpd-aceite" class="form-check-input mt-1 flex-shrink-0"
                               @bind="_model.AceiteLgpd" />
                        <label for="lgpd-aceite" class="form-check-label" style="font-size:.875rem;cursor:pointer">
                            Li e aceito os
                            <a href="/termos" target="_blank" style="color:#6c63ff">Termos de Uso</a>
                            e a
                            <a href="/privacidade" target="_blank" style="color:#6c63ff">Política de Privacidade</a>
                        </label>
                    </div>
                </div>

                <button class="btn btn-primary w-100 py-2" @onclick="HandleCadastro"
                        disabled="@(_carregando || !_model.AceiteLgpd)">
                    @if (_carregando) { <span class="spinner-border spinner-border-sm me-2"></span> }
                    Criar conta
                </button>

                <p class="text-center text-muted mt-3 mb-0" style="font-size:.875rem">
                    Já tem conta?
                    <a href="/login" style="color:#6c63ff;font-weight:600;text-decoration:none">Entrar</a>
                </p>
                <p class="text-center text-muted mt-2 mb-0" style="font-size:.75rem">
                    <a href="/privacidade" style="color:#adb5bd">Política de Privacidade</a>
                    ·
                    <a href="/termos" style="color:#adb5bd">Termos de Uso</a>
                </p>
            }
        </div>
    </div>
</div>

@code {
    private readonly FormModel _model = new();
    private string? _erro;
    private IReadOnlyList<string>? _erros;
    private bool _carregando;
    private bool _sucesso;

    private async Task HandleCadastro()
    {
        if (_model.Senha != _model.ConfirmarSenha)
        {
            _erro = "As senhas não conferem.";
            return;
        }

        _carregando = true; _erro = null; _erros = null;
        try
        {
            var response = await Http.PostAsJsonAsync("/bff/cadastrar", new
            {
                _model.RazaoSocial, _model.TipoInscricao, _model.NumeroInscricao,
                EmailCliente = _model.EmailCliente, _model.Telefone,
                _model.NomeResponsavel, EmailResponsavel = _model.EmailResponsavel,
                _model.Senha,
                AceiteLgpd = _model.AceiteLgpd,
            });

            if (response.IsSuccessStatusCode) { _sucesso = true; return; }

            if (response.StatusCode == System.Net.HttpStatusCode.Conflict)
            {
                var b = await response.Content.ReadFromJsonAsync<ErroResponse>();
                _erro = b?.Erro ?? "CPF/CNPJ ou e-mail já cadastrado.";
                return;
            }

            if (response.StatusCode == System.Net.HttpStatusCode.UnprocessableEntity)
            {
                var b = await response.Content.ReadFromJsonAsync<ErrosResponse>();
                _erros = b?.Erros; return;
            }

            _erro = "Erro inesperado. Tente novamente.";
        }
        catch { _erro = "Não foi possível conectar ao servidor."; }
        finally { _carregando = false; }
    }

    private sealed record ErroResponse(string Erro);
    private sealed record ErrosResponse(IReadOnlyList<string> Erros);

    private sealed class FormModel
    {
        public string RazaoSocial { get; set; } = string.Empty;
        public int TipoInscricao { get; set; } = 2;
        public string NumeroInscricao { get; set; } = string.Empty;
        public string EmailCliente { get; set; } = string.Empty;
        public string? Telefone { get; set; }
        public string NomeResponsavel { get; set; } = string.Empty;
        public string EmailResponsavel { get; set; } = string.Empty;
        public string Senha { get; set; } = string.Empty;
        public string ConfirmarSenha { get; set; } = string.Empty;
        public bool AceiteLgpd { get; set; }
    }
}
