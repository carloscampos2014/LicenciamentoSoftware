@page "/clientes-finais"
@attribute [Authorize]
@inject ClienteFinalApiService Service

<PageTitle>Clientes — Licenciamento</PageTitle>

<div class="page-header-row">
    <div class="page-header">
        <h1>Clientes</h1>
        <p>Gerencie sua base de clientes</p>
    </div>
    <button class="btn btn-primary" @onclick="AbrirNovo">
        + Novo Cliente
    </button>
</div>

<div class="mb-3">
    <input class="search-bar" placeholder="Buscar por nome, e-mail ou CNPJ..."
           @bind="_filtro" @bind:event="oninput" @onkeyup="HandleFiltro" />
</div>

@if (_carregando)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary" role="status"></div>
    </div>
}
else if (_erro is not null)
{
    <ApiError Erro="@_erro" />
}
else if (_itens.Count == 0)
{
    <div class="empty-state">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                  d="M17 20h5v-2a4 4 0 00-4-4h-1M9 20H4v-2a4 4 0 014-4h1m4-4a4 4 0 100-8 4 4 0 000 8z"/>
        </svg>
        <p>Nenhum cliente encontrado.</p>
    </div>
}
else
{
    <div class="cards-grid">
        @foreach (var item in _itens)
        {
            <div class="item-card">
                <div class="item-card-header">
                    <div>
                        <p class="item-card-title">@item.RazaoSocial</p>
                        <span class="badge-pill @(item.Ativo ? "badge-ativo" : "badge-inativo")">
                            @(item.Ativo ? "Ativo" : "Inativo")
                        </span>
                    </div>
                    <div class="item-card-icon" style="background:#f0eeff">
                        <svg width="18" height="18" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="#6c63ff">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                        </svg>
                    </div>
                </div>
                <div class="item-card-body">
                    <div class="item-card-row">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                        </svg>
                        @item.Email
                    </div>
                    @if (!string.IsNullOrEmpty(item.Telefone))
                    {
                        <div class="item-card-row">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                      d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                            </svg>
                            @item.Telefone
                        </div>
                    }
                    <div class="item-card-row mt-1">
                        <small class="text-muted">@(item.TipoInscricao == 1 ? "CPF" : "CNPJ"):</small>
                        <small class="text-muted">@item.NumeroInscricao</small>
                    </div>
                </div>
                <div class="item-card-footer">
                    <button class="btn btn-outline-secondary btn-sm" @onclick="() => AbrirEditar(item)">
                        Editar
                    </button>
                    @if (item.Ativo)
                    {
                        <button class="btn btn-outline-danger btn-sm"
                                @onclick="() => Desativar(item.Id, item.RazaoSocial)">
                            Desativar
                        </button>
                    }
                </div>
            </div>
        }
    </div>

    <Paginacao PaginaAtual="_pagina" TotalPaginas="_totalPaginas"
               Total="_total" OnPaginaMudou="MudarPagina" />
}

<!-- Modal formulário -->
<Modal Visivel="_modalAberto" Titulo="@_modalTitulo" OnFechar="FecharModal">
    <ChildContent>
        <div class="form-grid-2">
            <div class="form-group" style="grid-column:1/-1">
                <label class="form-label">Razão Social *</label>
                <input class="form-control" @bind="_form.RazaoSocial" />
            </div>
            @if (_editandoId is null)
            {
                <div class="form-group">
                    <label class="form-label">Tipo *</label>
                    <select class="form-select" @bind="_form.TipoInscricao">
                        <option value="1">CPF</option>
                        <option value="2">CNPJ</option>
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label">CPF / CNPJ *</label>
                    <input class="form-control" @bind="_form.NumeroInscricao" />
                </div>
            }
            <div class="form-group" style="grid-column:1/-1">
                <label class="form-label">E-mail *</label>
                <input class="form-control" type="email" @bind="_form.Email" />
            </div>
            <div class="form-group" style="grid-column:1/-1">
                <label class="form-label">Telefone</label>
                <input class="form-control" @bind="_form.Telefone" />
            </div>
        </div>
        <ApiError Erro="@_formErro" Erros="@_formErros" />
    </ChildContent>
    <Footer>
        <button class="btn btn-outline-secondary btn-sm" @onclick="FecharModal">Cancelar</button>
        <button class="btn btn-primary btn-sm" @onclick="Salvar" disabled="@_salvando">
            @if (_salvando) { <span class="spinner-border spinner-border-sm me-1"></span> }
            Salvar Cliente
        </button>
    </Footer>
</Modal>

<ConfirmDialog @ref="_confirmDialog" Titulo="Desativar cliente" TextoBotaoConfirmar="Desativar" />

@code {
    private List<ClienteFinalResult> _itens = [];
    private bool _carregando;
    private string? _erro;
    private string? _filtro;
    private int _pagina = 1, _totalPaginas = 1, _total;
    private ConfirmDialog _confirmDialog = default!;

    // Modal
    private bool _modalAberto;
    private string _modalTitulo = "Novo Cliente";
    private Guid? _editandoId;
    private readonly FormModel _form = new();
    private string? _formErro;
    private IReadOnlyList<string>? _formErros;
    private bool _salvando;

    protected override async Task OnInitializedAsync() => await CarregarAsync();

    private async Task CarregarAsync()
    {
        _carregando = true; _erro = null;
        try
        {
            var r = await Service.ListarAsync(_filtro, pagina: _pagina);
            if (r is null) { _erro = "Erro ao carregar."; return; }
            _itens = r.Itens.ToList(); _total = r.Total; _totalPaginas = r.TotalPaginas;
        }
        catch { _erro = "Erro ao conectar com o servidor."; }
        finally { _carregando = false; }
    }

    private async Task MudarPagina(int p) { _pagina = p; await CarregarAsync(); }
    private async Task HandleFiltro(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter") { _pagina = 1; await CarregarAsync(); }
    }

    private void AbrirNovo()
    {
        _editandoId = null; _modalTitulo = "Novo Cliente";
        _form.Reset(); _formErro = null; _formErros = null;
        _modalAberto = true;
    }

    private void AbrirEditar(ClienteFinalResult item)
    {
        _editandoId = item.Id; _modalTitulo = "Editar Cliente";
        _form.RazaoSocial = item.RazaoSocial;
        _form.Email = item.Email;
        _form.Telefone = item.Telefone;
        _formErro = null; _formErros = null;
        _modalAberto = true;
    }

    private void FecharModal() => _modalAberto = false;

    private async Task Salvar()
    {
        _salvando = true; _formErro = null; _formErros = null;
        bool sucesso;
        if (_editandoId.HasValue)
        {
            var (s, _, e, erros) = await Service.AtualizarAsync(
                _editandoId.Value, new(_form.RazaoSocial, _form.Email, _form.Telefone));
            sucesso = s; _formErro = e; _formErros = erros;
        }
        else
        {
            var (s, _, e, erros) = await Service.CriarAsync(
                new(_form.RazaoSocial, _form.TipoInscricao, _form.NumeroInscricao, _form.Email, _form.Telefone));
            sucesso = s; _formErro = e; _formErros = erros;
        }
        _salvando = false;
        if (sucesso) { _modalAberto = false; await CarregarAsync(); }
    }

    private async Task Desativar(Guid id, string nome)
    {
        _confirmDialog.Mensagem = $"Desativar \"{nome}\"? Esta ação não pode ser desfeita.";
        if (!await _confirmDialog.MostrarAsync()) return;
        var (sucesso, erro) = await Service.DesativarAsync(id);
        if (sucesso) await CarregarAsync();
        else _erro = erro;
    }

    private sealed class FormModel
    {
        public string RazaoSocial { get; set; } = string.Empty;
        public int TipoInscricao { get; set; } = 2;
        public string NumeroInscricao { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string? Telefone { get; set; }
        public void Reset() { RazaoSocial = string.Empty; TipoInscricao = 2; NumeroInscricao = string.Empty; Email = string.Empty; Telefone = null; }
    }
}
