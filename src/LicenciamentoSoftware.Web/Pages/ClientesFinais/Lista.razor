@page "/clientes-finais"
@attribute [Authorize]
@inject ClienteFinalApiService Service
@inject NavigationManager Nav

<PageTitle>Clientes Finais</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">Clientes Finais</h3>
    <AuthorizeView Roles="AdministradorCliente,OperadorCliente">
        <Authorized>
            <a href="/clientes-finais/novo" class="btn btn-primary btn-sm">+ Novo</a>
        </Authorized>
    </AuthorizeView>
</div>

<div class="row g-2 mb-3">
    <div class="col-md-4">
        <input class="form-control form-control-sm" placeholder="Filtrar por razão social..."
               @bind="_filtroRazaoSocial" @bind:event="oninput" @onkeyup="HandleFiltro" />
    </div>
    <div class="col-auto">
        <button class="btn btn-outline-secondary btn-sm" @onclick="CarregarAsync">Buscar</button>
    </div>
</div>

@if (_carregando)
{
    <p class="text-muted"><span class="spinner-border spinner-border-sm me-1"></span>Carregando...</p>
}
else if (_erro is not null)
{
    <ApiError Erro="@_erro" />
}
else if (_itens.Count == 0)
{
    <p class="text-muted">Nenhum cliente final encontrado.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover table-sm align-middle">
            <thead class="table-light">
                <tr>
                    <th>Razão Social</th>
                    <th>CPF/CNPJ</th>
                    <th>E-mail</th>
                    <th>Situação</th>
                    <th class="text-end">Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in _itens)
                {
                    <tr>
                        <td>@item.RazaoSocial</td>
                        <td><code>@item.NumeroInscricao</code></td>
                        <td>@item.Email</td>
                        <td>
                            <span class="badge @(item.Ativo ? "bg-success" : "bg-secondary")">
                                @(item.Ativo ? "Ativo" : "Inativo")
                            </span>
                        </td>
                        <td class="text-end">
                            <AuthorizeView Roles="AdministradorCliente,OperadorCliente">
                                <Authorized>
                                    <a href="/clientes-finais/@item.Id/editar"
                                       class="btn btn-outline-secondary btn-sm me-1">Editar</a>
                                    @if (item.Ativo)
                                    {
                                        <button class="btn btn-outline-danger btn-sm"
                                                @onclick="() => Desativar(item.Id, item.RazaoSocial)">
                                            Desativar
                                        </button>
                                    }
                                </Authorized>
                            </AuthorizeView>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <Paginacao PaginaAtual="_pagina" TotalPaginas="_totalPaginas"
               Total="_total" OnPaginaMudou="MudarPagina" />
}

<ConfirmDialog @ref="_confirmDialog"
               Titulo="Desativar cliente final"
               TextoBotaoConfirmar="Desativar" />

@code {
    private List<ClienteFinalResult> _itens = [];
    private bool _carregando;
    private string? _erro;
    private string? _filtroRazaoSocial;
    private int _pagina = 1;
    private int _totalPaginas = 1;
    private int _total;
    private ConfirmDialog _confirmDialog = default!;

    protected override async Task OnInitializedAsync()
        => await CarregarAsync();

    private async Task CarregarAsync()
    {
        _carregando = true;
        _erro = null;
        try
        {
            var result = await Service.ListarAsync(_filtroRazaoSocial, pagina: _pagina);
            if (result is null) { _erro = "Erro ao carregar."; return; }
            _itens = result.Itens.ToList();
            _total = result.Total;
            _totalPaginas = result.TotalPaginas;
        }
        catch { _erro = "Erro ao conectar com o servidor."; }
        finally { _carregando = false; }
    }

    private async Task MudarPagina(int pagina) { _pagina = pagina; await CarregarAsync(); }
    private async Task HandleFiltro(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter") { _pagina = 1; await CarregarAsync(); }
    }

    private async Task Desativar(Guid id, string razaoSocial)
    {
        _confirmDialog.Mensagem = $"Desativar \"{razaoSocial}\"? Esta ação não pode ser desfeita.";
        var confirmado = await _confirmDialog.MostrarAsync();
        if (!confirmado) return;

        var (sucesso, erro) = await Service.DesativarAsync(id);
        if (sucesso) await CarregarAsync();
        else _erro = erro;
    }
}
