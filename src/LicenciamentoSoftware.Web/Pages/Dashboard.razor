@page "/dashboard"
@attribute [Authorize]
@inject DashboardApiService Service
@inject TotpApiService TotpService
@inject NavigationManager Nav
@using LicenciamentoSoftware.Client.Models.Dashboard

<PageTitle>Dashboard — Licenciamento</PageTitle>

<!-- Banner 2FA — não bloqueante, aparece só se 2FA estiver inativo -->
@if (_mostrarBanner2FA)
{
    <div style="background:#fffbeb;border:1px solid #fbbf24;border-radius:8px;padding:.75rem 1rem;
                margin-bottom:1rem;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:.5rem">
        <div style="display:flex;align-items:center;gap:.6rem">
            <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="#d97706">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
            </svg>
            <span style="font-size:.875rem;color:#92400e">
                Sua conta não tem autenticação de dois fatores ativada.
            </span>
        </div>
        <div style="display:flex;gap:.5rem">
            <a href="/minha-conta#2fa" class="btn btn-sm btn-warning" style="font-size:.8rem">
                Ativar agora
            </a>
            <button class="btn btn-sm btn-outline-secondary" style="font-size:.8rem"
                    @onclick="() => _mostrarBanner2FA = false">
                Lembrar depois
            </button>
        </div>
    </div>
}

<div class="page-header">
    <h1>Dashboard</h1>
    <p>Visão geral do sistema de licenças</p>
</div>

@if (_carregando)
{
    <div class="cards-grid mb-4">
        @for (int i = 0; i < 6; i++)
        {
            <div class="metric-card metric-card--skeleton"></div>
        }
    </div>
}
else if (_erroResumo is not null)
{
    <ApiError Erro="@_erroResumo" />
}
else if (_resumo is not null)
{
    <!-- Linha 1: métricas principais -->
    <div class="cards-grid mb-3">
        <MetricaCard Titulo="Clientes Finais"
                     Valor="@_resumo.TotalClientesFinaisAtivos"
                     Subtitulo="@($"+{_resumo.NovosClientesFinaisUltimos30Dias} nos últimos 30 dias")"
                     Cor="#6c63ff" Icone="pessoas" />

        <MetricaCard Titulo="Aplicações"
                     Valor="@_resumo.TotalAplicacoesAtivas"
                     Subtitulo="Registradas"
                     Cor="#10b981" Icone="app" />

        <MetricaCard Titulo="Licenças Ativas"
                     Valor="@_resumo.TotalLicencasAtivas"
                     Subtitulo="@($"{_resumo.TotalLicencasInativas} inativas")"
                     Cor="#3b82f6" Icone="chave" />

        <MetricaCard Titulo="Expirando em 7 dias"
                     Valor="@_resumo.LicencasExpirandoEm7Dias"
                     Subtitulo="Requer atenção"
                     Cor="@(_resumo.LicencasExpirandoEm7Dias > 0 ? "#f59e0b" : "#10b981")"
                     Icone="alerta"
                     Alerta="@(_resumo.LicencasExpirandoEm7Dias > 0)" />
    </div>

    <!-- Linha 2: métricas operacionais -->
    <div class="cards-grid mb-4">
        <MetricaCard Titulo="Sessões abertas agora"
                     Valor="@_resumo.SessoesAtivasAgora"
                     Subtitulo="Em uso"
                     Cor="#8b5cf6" Icone="usuarios" />

        <MetricaCard Titulo="Tokens expirando em 7 dias"
                     Valor="@_resumo.TokensExpirandoEm7Dias"
                     Subtitulo="Tokens HMAC ativos"
                     Cor="@(_resumo.TokensExpirandoEm7Dias > 0 ? "#f59e0b" : "#10b981")"
                     Icone="token"
                     Alerta="@(_resumo.TokensExpirandoEm7Dias > 0)" />

        <MetricaCard Titulo="Novas licenças (30 dias)"
                     Valor="@_resumo.NovasLicencasUltimos30Dias"
                     Subtitulo="Emitidas recentemente"
                     Cor="#06b6d4" Icone="novo" />
    </div>

    <!-- Breakdown por tipo -->
    <div class="item-card mb-4">
        <p class="fw-semibold mb-3 small text-muted text-uppercase" style="letter-spacing:.05em">
            Licenças por tipo
        </p>
        <div class="d-flex gap-2 flex-wrap">
            <span class="badge-pill badge-permanente" style="font-size:.8rem;padding:.3rem .8rem">
                Permanente: @_resumo.LicencasPorTipo.Permanente
            </span>
            <span class="badge-pill badge-periodo" style="font-size:.8rem;padding:.3rem .8rem">
                Por Período: @_resumo.LicencasPorTipo.PorPeriodo
            </span>
            <span class="badge-pill badge-usuarios" style="font-size:.8rem;padding:.3rem .8rem">
                Por Usuários: @_resumo.LicencasPorTipo.PorUsuarios
            </span>
            <span class="badge-pill badge-instalacao" style="font-size:.8rem;padding:.3rem .8rem">
                Por Instalação: @_resumo.LicencasPorTipo.PorInstalacao
            </span>
        </div>
    </div>
}

<!-- Seção de alertas -->
@if (!_carregandoAlertas && _alertas is not null && TemAlertas())
{
    <div class="item-card mb-3" style="border-left:3px solid #f59e0b">
        <div class="d-flex align-items-center gap-2 mb-3">
            <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="#f59e0b">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
            </svg>
            <p class="fw-semibold mb-0">Alertas operacionais</p>
        </div>

        @if (_alertas.ErrosValidacao.TotalErros > 0)
        {
            <div class="mb-3">
                <p class="small fw-semibold text-muted text-uppercase mb-2" style="letter-spacing:.04em">
                    Erros de validação nas últimas 24h
                </p>
                <div class="d-flex gap-2 align-items-center flex-wrap">
                    <span class="badge-pill" style="background:#fee2e2;color:#991b1b;font-size:.8rem;padding:.3rem .8rem">
                        Total: @_alertas.ErrosValidacao.TotalErros
                    </span>
                    @foreach (var motivo in _alertas.ErrosValidacao.PorMotivo)
                    {
                        <span class="badge-pill badge-inativo" style="font-size:.75rem">
                            @motivo.Motivo.Replace("_", " "): @motivo.Total
                        </span>
                    }
                </div>
            </div>
        }

        @if (_alertas.LicencasNoLimite.Count > 0)
        {
            <div class="mb-3">
                <p class="small fw-semibold text-muted text-uppercase mb-2" style="letter-spacing:.04em">
                    Licenças no limite de capacidade (@_alertas.LicencasNoLimite.Count)
                </p>
                @foreach (var l in _alertas.LicencasNoLimite.Take(5))
                {
                    <div class="d-flex justify-content-between align-items-center py-1 border-bottom">
                        <div>
                            <small class="fw-semibold">@l.ClienteFinalRazaoSocial</small>
                            <small class="text-muted ms-1">— @l.AplicativoTitulo</small>
                        </div>
                        <span class="badge-pill" style="background:#fee2e2;color:#991b1b;font-size:.7rem">
                            @l.UsoAtual/@l.Maximo @l.TipoLicenca
                        </span>
                    </div>
                }
            </div>
        }

        @if (_alertas.SessoesInativas.Count > 0)
        {
            <div class="mb-3">
                <p class="small fw-semibold text-muted text-uppercase mb-2" style="letter-spacing:.04em">
                    Sessões inativas prolongadas (@_alertas.SessoesInativas.Count)
                </p>
                @foreach (var s in _alertas.SessoesInativas.Take(5))
                {
                    <div class="d-flex justify-content-between align-items-center py-1 border-bottom">
                        <div>
                            <small class="fw-semibold">@s.ClienteFinalRazaoSocial</small>
                            <small class="text-muted ms-1">— @s.IdentificadorUsuario</small>
                        </div>
                        <span class="badge-pill badge-inativo" style="font-size:.7rem">
                            @s.HorasInativa h inativa
                        </span>
                    </div>
                }
            </div>
        }

        @if (_alertas.InstalacoesAdormecidas.Count > 0)
        {
            <p class="small fw-semibold text-muted text-uppercase mb-2" style="letter-spacing:.04em">
                Instalações adormecidas (@_alertas.InstalacoesAdormecidas.Count)
            </p>
            @foreach (var ins in _alertas.InstalacoesAdormecidas.Take(5))
            {
                <div class="d-flex justify-content-between align-items-center py-1 border-bottom">
                    <div>
                        <small class="fw-semibold">@ins.ClienteFinalRazaoSocial</small>
                        <small class="text-muted ms-1">— <code style="font-size:.7rem">@ins.IdentificadorMaquina</code></small>
                    </div>
                    <span class="badge-pill badge-inativo" style="font-size:.7rem">
                        @ins.DiasAdormecida dias
                    </span>
                </div>
            }
        }
    </div>
}

@code {
    private DashboardResumoResult? _resumo;
    private DashboardAlertasResult? _alertas;
    private bool _carregando = true;
    private bool _carregandoAlertas = true;
    private string? _erroResumo;
    private bool _mostrarBanner2FA;

    protected override async Task OnInitializedAsync()
    {
        var resumoTask   = CarregarResumoAsync();
        var alertasTask  = CarregarAlertasAsync();
        var banner2FATask = CarregarStatus2FAAsync();
        await Task.WhenAll(resumoTask, alertasTask, banner2FATask);
    }

    private async Task CarregarStatus2FAAsync()
    {
        try
        {
            var ativo = await TotpService.BuscarStatusAsync();
            _mostrarBanner2FA = ativo == false;
        }
        catch { /* banner é opcional — falha silenciosa */ }
    }

    private async Task CarregarResumoAsync()
    {
        try
        {
            _resumo = await Service.BuscarResumoAsync();
        }
        catch { _erroResumo = "Erro ao carregar métricas."; }
        finally { _carregando = false; StateHasChanged(); }
    }

    private async Task CarregarAlertasAsync()
    {
        try { _alertas = await Service.BuscarAlertasAsync(); }
        catch { /* alertas são opcionais — falha silenciosa */ }
        finally { _carregandoAlertas = false; StateHasChanged(); }
    }

    private bool TemAlertas() =>
        _alertas is not null &&
        (_alertas.ErrosValidacao.TotalErros > 0 ||
         _alertas.LicencasNoLimite.Count > 0 ||
         _alertas.SessoesInativas.Count > 0 ||
         _alertas.InstalacoesAdormecidas.Count > 0);
}
