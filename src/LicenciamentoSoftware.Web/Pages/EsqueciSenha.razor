@page "/esqueci-senha"
@layout Layout.PublicLayout
@inject HttpClient Http
@inject NavigationManager Nav

<PageTitle>Esqueci minha senha — LicenseManager</PageTitle>

<div style="min-height:100vh;display:flex;align-items:center;justify-content:center;background:#f8f9fa">
    <div style="width:100%;max-width:420px;padding:2rem">
        <div class="text-center mb-4">
            <div style="width:48px;height:48px;background:#6c63ff;border-radius:12px;
                        display:inline-flex;align-items:center;justify-content:center;
                        font-weight:700;font-size:1.1rem;color:white;margin-bottom:1rem">LS</div>
            <h1 style="font-size:1.4rem;font-weight:700;color:#212529">Recuperar senha</h1>
            <p class="text-muted" style="font-size:.875rem">
                Informe seu e-mail e enviaremos um link para redefinir sua senha.
            </p>
        </div>

        @if (_enviado)
        {
            <div class="alert alert-success text-center">
                <strong>Link enviado!</strong><br/>
                Se o e-mail estiver cadastrado, você receberá um link em instantes.
                Verifique também a caixa de spam.
            </div>
            <div class="text-center mt-3">
                <a href="/login" style="color:#6c63ff;font-size:.875rem">← Voltar ao login</a>
            </div>
        }
        else
        {
            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <div class="form-group mb-3">
                        <label class="form-label fw-semibold">E-mail</label>
                        <input class="form-control" type="email"
                               @bind="_email" @onkeydown="HandleEnter"
                               placeholder="seu@email.com" disabled="@_carregando" />
                    </div>

                    @if (_erro is not null)
                    {
                        <div class="alert alert-danger py-2 px-3 mb-3" style="font-size:.875rem">@_erro</div>
                    }

                    <button class="btn btn-primary w-100 py-2" @onclick="Enviar" disabled="@_carregando">
                        @if (_carregando) { <span class="spinner-border spinner-border-sm me-2"></span> }
                        Enviar link de recuperação
                    </button>
                </div>
            </div>
            <div class="text-center mt-3">
                <a href="/login" style="color:#6c63ff;font-size:.875rem">← Voltar ao login</a>
            </div>
        }
    </div>
</div>

@code {
    private string _email = string.Empty;
    private string? _erro;
    private bool _carregando;
    private bool _enviado;

    private async Task Enviar()
    {
        if (string.IsNullOrWhiteSpace(_email)) { _erro = "Informe o e-mail."; return; }
        _erro = null;
        _carregando = true;
        try
        {
            await Http.PostAsJsonAsync("api/auth/esqueci-senha", new { Email = _email });
            // Sempre mostra sucesso — não vaza se e-mail existe
            _enviado = true;
        }
        catch
        {
            _erro = "Erro ao enviar. Tente novamente.";
        }
        finally { _carregando = false; }
    }

    private async Task HandleEnter(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await Enviar();
    }
}
