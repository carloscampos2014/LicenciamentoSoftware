@page "/licencas/{Id:guid}"
@attribute [Authorize]
@inject LicencaApiService Service

<PageTitle>Detalhe da Licença — Licenciamento</PageTitle>

@if (_carregando)
{
    <div class="text-center py-5"><div class="spinner-border text-primary" role="status"></div></div>
}
else if (_licenca is null)
{
    <ApiError Erro="Licença não encontrada." />
}
else
{
    <div class="page-header-row">
        <div class="page-header">
            <h1>@_licenca.ClienteFinalRazaoSocial</h1>
            <p>@_licenca.AplicativoTitulo</p>
        </div>
        <div class="d-flex gap-2 align-items-center">
            <span class="badge-pill @(_licenca.Ativo ? "badge-ativo" : "badge-inativo")">
                @(_licenca.Ativo ? "Ativa" : "Inativa")
            </span>
            <span class="badge-pill @BadgeTipo(_licenca.TipoLicenca)">@_licenca.TipoLicenca</span>
            <a href="/licencas" class="btn btn-outline-secondary btn-sm ms-2">← Voltar</a>
        </div>
    </div>

    <ApiError Erro="@_erro" />

    <!-- Detalhes do período -->
    @if (_licenca.Periodo is { } p)
    {
        <div class="item-card mb-3">
            <p class="fw-semibold mb-2">Período</p>
            <div class="row g-2">
                <div class="col-sm-4">
                    <small class="text-muted d-block">Início</small>
                    <span>@p.DataInicio.ToString("dd/MM/yyyy")</span>
                </div>
                <div class="col-sm-4">
                    <small class="text-muted d-block">Fim</small>
                    <span>@p.DataFim.ToString("dd/MM/yyyy")</span>
                </div>
                <div class="col-sm-4">
                    <small class="text-muted d-block">Renovação auto</small>
                    <span>@(p.RenovacaoAutomatica ? "Sim" : "Não")</span>
                </div>
            </div>
            <div class="d-flex gap-2 align-items-center mt-3">
                <label class="form-label mb-0 small">Nova data fim:</label>
                <input type="date" class="form-control form-control-sm" style="width:160px"
                       @bind="_novaDataFim" />
                <button class="btn btn-outline-primary btn-sm" @onclick="RenovarPeriodo" disabled="@_salvando">
                    Renovar período
                </button>
            </div>
        </div>
    }

    <!-- Sessões ativas -->
    @if (_licenca.Sessoes?.Any(s => s.Ativo) == true)
    {
        <div class="item-card mb-3">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <p class="fw-semibold mb-0">Sessões ativas</p>
                <span class="badge-pill badge-usuarios">@(_licenca.Sessoes?.Count(s => s.Ativo) ?? 0) ativas</span>
            </div>
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Identificador</th>
                            <th>Login</th>
                            <th>Última atividade</th>
                            <th class="text-end"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in (_licenca.Sessoes ?? []).Where(s => s.Ativo))
                        {
                            <tr>
                                <td><code style="font-size:.75rem">@s.IdentificadorUsuario</code></td>
                                <td><small>@s.DataLogin.ToString("dd/MM HH:mm")</small></td>
                                <td><small>@s.DataUltimaAtividade.ToString("dd/MM HH:mm")</small></td>
                                <td class="text-end">
                                    <button class="btn btn-outline-danger btn-sm"
                                            @onclick="() => EncerrarSessao(s.Id)" disabled="@_salvando">
                                        Encerrar
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <!-- Instalações registradas -->
    @if (_licenca.InstalacoesRegistradas?.Any(i => i.Ativo) == true)
    {
        <div class="item-card mb-3">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <p class="fw-semibold mb-0">Instalações registradas</p>
                @if (_licenca.Instalacao is not null)
                {
                    <span class="badge-pill badge-instalacao">
                        @(_licenca.InstalacoesRegistradas?.Count(i => i.Ativo) ?? 0) / @_licenca.Instalacao.QuantidadeMaxima
                    </span>
                }
            </div>
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Identificador da máquina</th>
                            <th>Registrado em</th>
                            <th class="text-end"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ins in (_licenca.InstalacoesRegistradas ?? []).Where(i => i.Ativo))
                        {
                            <tr>
                                <td><code style="font-size:.75rem">@ins.IdentificadorMaquina</code></td>
                                <td><small>@ins.DataRegistro.ToString("dd/MM/yyyy")</small></td>
                                <td class="text-end">
                                    <button class="btn btn-outline-danger btn-sm"
                                            @onclick="() => LiberarInstalacao(ins.Id)" disabled="@_salvando">
                                        Liberar
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}

<ConfirmDialog @ref="_confirmDialog" Titulo="Confirmar ação" TextoBotaoConfirmar="Confirmar" />

@code {
    [Parameter] public Guid Id { get; set; }

    private LicencaResult? _licenca;
    private bool _carregando, _salvando;
    private string? _erro;
    private DateTime _novaDataFim = DateTime.Today.AddMonths(1);
    private ConfirmDialog _confirmDialog = default!;

    protected override async Task OnInitializedAsync() => await CarregarAsync();

    private async Task CarregarAsync()
    {
        _carregando = true; _erro = null;
        _licenca = await Service.BuscarPorIdAsync(Id);
        _carregando = false;
    }

    private async Task RenovarPeriodo()
    {
        _confirmDialog.Mensagem = $"Renovar o período até {_novaDataFim:dd/MM/yyyy}?";
        if (!await _confirmDialog.MostrarAsync()) return;
        _salvando = true;
        var (sucesso, _, erro) = await Service.RenovarPeriodoAsync(Id, new(_novaDataFim));
        _erro = sucesso ? null : erro; _salvando = false;
        if (sucesso) await CarregarAsync();
    }

    private async Task EncerrarSessao(Guid idSessao)
    {
        _confirmDialog.Mensagem = "Encerrar esta sessão?";
        if (!await _confirmDialog.MostrarAsync()) return;
        _salvando = true;
        var (sucesso, erro) = await Service.EncerrarSessaoAsync(Id, idSessao);
        _erro = sucesso ? null : erro; _salvando = false;
        if (sucesso) await CarregarAsync();
    }

    private async Task LiberarInstalacao(Guid idInstalacao)
    {
        _confirmDialog.Mensagem = "Liberar esta instalação?";
        if (!await _confirmDialog.MostrarAsync()) return;
        _salvando = true;
        var (sucesso, erro) = await Service.LiberarInstalacaoAsync(Id, idInstalacao);
        _erro = sucesso ? null : erro; _salvando = false;
        if (sucesso) await CarregarAsync();
    }

    private static string BadgeTipo(string tipo) => tipo switch
    {
        "Permanente"     => "badge-permanente",
        "Por Período"    => "badge-periodo",
        "Por Usuários"   => "badge-usuarios",
        "Por Instalação" => "badge-instalacao",
        _                => "badge-inativo"
    };
}
