@page "/licencas/emitir"
@attribute [Authorize]
@inject LicencaApiService LicencaService
@inject AplicacaoApiService AplicacaoService
@inject ClienteFinalApiService ClienteFinalService
@inject NavigationManager Nav

<PageTitle>Nova Licença — Licenciamento</PageTitle>

<div class="page-header-row">
    <div class="page-header">
        <h1>Nova Licença</h1>
        <p>Gerencie licenças e controle de acesso</p>
    </div>
    <a href="/licencas" class="btn btn-outline-secondary btn-sm">← Voltar</a>
</div>

@if (_passo == 3)
{
    <!-- Sucesso -->
    <div class="item-card" style="max-width:560px">
        <div class="item-card-header">
            <div>
                <p class="item-card-title">Licença emitida com sucesso!</p>
                <span class="badge-pill badge-ativo">Ativa</span>
            </div>
            <div class="item-card-icon" style="background:#d1fae5">
                <svg width="20" height="20" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="#065f46">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                </svg>
            </div>
        </div>
        @if (_tokenEmitido is not null)
        {
            <div class="alert alert-warning mt-2">
                <strong>Token HMAC gerado — exibido uma única vez:</strong>
                <div class="mt-1">
                    <code class="user-select-all" style="word-break:break-all">@_tokenEmitido</code>
                </div>
                <small class="text-danger d-block mt-1">Copie e guarde com segurança antes de sair desta página.</small>
            </div>
        }
        <div class="item-card-footer">
            <a href="/licencas" class="btn btn-primary btn-sm">Ver licenças</a>
            @if (_idLicencaEmitida != Guid.Empty)
            {
                <a href="/licencas/@_idLicencaEmitida" class="btn btn-outline-secondary btn-sm">Ver detalhes</a>
            }
        </div>
    </div>
}
else
{
    <div class="item-card" style="max-width:560px">
        <!-- Indicador de passos -->
        <div class="d-flex gap-2 mb-4">
            <span class="badge-pill @(_passo >= 1 ? "badge-ativo" : "badge-inativo")" style="font-size:.75rem">1. Seleção</span>
            <span class="text-muted">→</span>
            <span class="badge-pill @(_passo >= 2 ? "badge-ativo" : "badge-inativo")" style="font-size:.75rem">2. Configuração</span>
        </div>

        @if (_passo == 1)
        {
            <h5 class="fw-600 mb-3">Selecione a aplicação e o cliente final</h5>

            @if (_carregando)
            {
                <div class="text-center py-3"><div class="spinner-border text-primary" role="status"></div></div>
            }
            else
            {
                <div class="form-group">
                    <label class="form-label">Aplicação *</label>
                    <select class="form-select" @bind="_idAplicacao">
                        <option value="">— selecione —</option>
                        @foreach (var a in _aplicacoes)
                        {
                            <option value="@a.Id">@a.Titulo (@a.TipoLicencaDescricao)</option>
                        }
                    </select>
                </div>

                <div class="form-group">
                    <label class="form-label">Cliente Final *</label>
                    <select class="form-select" @bind="_idClienteFinal">
                        <option value="">— selecione —</option>
                        @foreach (var c in _clientesFinais)
                        {
                            <option value="@c.Id">@c.RazaoSocial</option>
                        }
                    </select>
                </div>

                <ApiError Erro="@_erro" />

                <div class="d-flex justify-content-end mt-3">
                    <button class="btn btn-primary"
                            @onclick="AvancarPasso1"
                            disabled="@(_idAplicacao == Guid.Empty || _idClienteFinal == Guid.Empty)">
                        Próximo →
                    </button>
                </div>
            }
        }
        else if (_passo == 2)
        {
            <h5 class="fw-600 mb-1">Configurar detalhes</h5>
            <p class="text-muted small mb-3">
                Tipo: <span class="badge-pill @BadgeTipo(_tipoLicenca)">@_tipoLicenca</span>
            </p>

            @if (_tipoLicenca == "Permanente")
            {
                <div class="alert alert-light border">
                    <small class="text-muted">Licença permanente não requer configuração adicional.</small>
                </div>
            }
            else if (_tipoLicenca == "Por Período")
            {
                <div class="form-grid-2">
                    <div class="form-group">
                        <label class="form-label">Data início *</label>
                        <InputDate class="form-control" @bind-Value="_dataInicio" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Data fim *</label>
                        <InputDate class="form-control" @bind-Value="_dataFim" />
                    </div>
                </div>
                <div class="form-group form-check">
                    <InputCheckbox class="form-check-input" id="renovacao" @bind-Value="_renovacaoAutomatica" />
                    <label class="form-check-label" for="renovacao">Renovação automática</label>
                </div>
            }
            else if (_tipoLicenca == "Por Usuários")
            {
                <div class="form-grid-2">
                    <div class="form-group">
                        <label class="form-label">Máx. usuários *</label>
                        <InputNumber class="form-control" @bind-Value="_qtdMaxUsuarios" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Máx. sessões/usuário</label>
                        <InputNumber class="form-control" @bind-Value="_maxSessoesPorUsuario" />
                    </div>
                </div>
                <div class="form-group">
                    <label class="form-label">Limite de sessão (horas)</label>
                    <InputNumber class="form-control" @bind-Value="_tempoLimiteSessaoHoras" />
                </div>
            }
            else if (_tipoLicenca == "Por Instalação")
            {
                <div class="form-group">
                    <label class="form-label">Máx. instalações *</label>
                    <InputNumber class="form-control" @bind-Value="_qtdMaxInstalacoes" />
                </div>
            }

            <div class="form-group form-check mt-2">
                <InputCheckbox class="form-check-input" id="emitirToken" @bind-Value="_emitirToken" />
                <label class="form-check-label" for="emitirToken">
                    Gerar token HMAC junto com a licença
                </label>
            </div>

            <ApiError Erro="@_erro" />

            <div class="d-flex justify-content-between mt-3">
                <button class="btn btn-outline-secondary" @onclick="() => _passo = 1">← Voltar</button>
                <button class="btn btn-primary" @onclick="EmitirLicenca" disabled="@_salvando">
                    @if (_salvando) { <span class="spinner-border spinner-border-sm me-1"></span> }
                    Emitir licença
                </button>
            </div>
        }
    </div>
}

@code {
    private int _passo = 1;
    private bool _carregando, _salvando;
    private string? _erro;

    private Guid _idAplicacao = Guid.Empty;
    private Guid _idClienteFinal = Guid.Empty;
    private string _tipoLicenca = string.Empty;
    private List<AplicacaoResult> _aplicacoes = [];
    private List<ClienteFinalResult> _clientesFinais = [];

    private DateTime _dataInicio = DateTime.Today;
    private DateTime _dataFim = DateTime.Today.AddYears(1);
    private bool _renovacaoAutomatica;
    private int _qtdMaxUsuarios = 10;
    private int _maxSessoesPorUsuario = 5;
    private int _tempoLimiteSessaoHoras = 24;
    private int _qtdMaxInstalacoes = 5;
    private bool _emitirToken;

    private string? _tokenEmitido;
    private Guid _idLicencaEmitida;

    protected override async Task OnInitializedAsync()
    {
        _carregando = true;
        try
        {
            var ap = await AplicacaoService.ListarAsync(ativo: true, tamanhoPagina: 100);
            var cf = await ClienteFinalService.ListarAsync(ativo: true, tamanhoPagina: 100);
            _aplicacoes = ap?.Itens.ToList() ?? [];
            _clientesFinais = cf?.Itens.ToList() ?? [];
        }
        finally { _carregando = false; }
    }

    private void AvancarPasso1()
    {
        var app = _aplicacoes.FirstOrDefault(a => a.Id == _idAplicacao);
        if (app is null) { _erro = "Selecione uma aplicação."; return; }
        _tipoLicenca = app.TipoLicencaDescricao;
        _erro = null; _passo = 2;
    }

    private async Task EmitirLicenca()
    {
        _salvando = true; _erro = null;
        try
        {
            var request = new EmitirLicencaRequest(
                _idClienteFinal, _idAplicacao,
                _tipoLicenca == "Por Período"    ? new(_dataInicio, _dataFim, _renovacaoAutomatica) : null,
                _tipoLicenca == "Por Usuários"   ? new(_qtdMaxUsuarios, _maxSessoesPorUsuario, _tempoLimiteSessaoHoras) : null,
                _tipoLicenca == "Por Instalação" ? new(_qtdMaxInstalacoes) : null,
                _emitirToken);

            var (sucesso, result, erro, erros) = await LicencaService.EmitirAsync(request);
            if (!sucesso) { _erro = erro ?? string.Join("; ", erros ?? []); return; }

            if (result is System.Text.Json.JsonElement el)
            {
                _idLicencaEmitida = el.TryGetProperty("licenca", out var lic) && lic.TryGetProperty("id", out var idEl)
                    ? idEl.GetGuid() : Guid.Empty;
                _tokenEmitido = el.TryGetProperty("tokenTexto", out var tok) ? tok.GetString() : null;
            }
            _passo = 3;
        }
        finally { _salvando = false; }
    }

    private static string BadgeTipo(string tipo) => tipo switch
    {
        "Permanente"     => "badge-permanente",
        "Por Período"    => "badge-periodo",
        "Por Usuários"   => "badge-usuarios",
        "Por Instalação" => "badge-instalacao",
        _                => "badge-inativo"
    };
}
