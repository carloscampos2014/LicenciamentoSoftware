@page "/login"
@layout Layout.PublicLayout
@inject HttpClient Http
@inject JwtAuthStateProvider AuthProvider
@inject NavigationManager Nav

<PageTitle>Entrar — LicenseManager</PageTitle>

<div style="min-height:100vh;display:flex">
    <!-- Painel esquerdo decorativo -->
    <div class="d-none d-lg-flex flex-column justify-content-between p-5"
         style="width:420px;background:#6c63ff;flex-shrink:0">
        <div>
            <div style="width:44px;height:44px;background:rgba(255,255,255,.2);border-radius:10px;
                        display:flex;align-items:center;justify-content:center;
                        font-weight:700;font-size:1rem;color:white">
                LS
            </div>
            <div class="mt-2" style="color:white;font-weight:700;font-size:1rem">LicenseManager</div>
            <div style="color:rgba(255,255,255,.7);font-size:.75rem">Sistema de Licenças</div>
        </div>
        <div>
            <h2 style="color:white;font-size:1.75rem;font-weight:700;line-height:1.3">
                Gerencie suas licenças com segurança e eficiência
            </h2>
            <p style="color:rgba(255,255,255,.75);font-size:.875rem;margin-top:.75rem">
                Controle de acesso, emissão de tokens HMAC e monitoramento de sessões em um só lugar.
            </p>
        </div>
        <div style="color:rgba(255,255,255,.5);font-size:.75rem">
            © 2026 LicenseManager
        </div>
    </div>

    <!-- Painel direito — formulário -->
    <div class="flex-grow-1 d-flex align-items-center justify-content-center p-4">
        <div style="width:100%;max-width:380px">
            <!-- Logo mobile -->
            <div class="d-lg-none text-center mb-4">
                <div class="sidebar-brand-icon mx-auto mb-2">LS</div>
                <div style="font-weight:700;font-size:1rem">LicenseManager</div>
                <div class="text-muted" style="font-size:.75rem">Sistema de Licenças</div>
            </div>

            <h1 style="font-size:1.5rem;font-weight:700;color:#212529;margin-bottom:.25rem">Bem-vindo</h1>
            <p class="text-muted mb-4" style="font-size:.875rem">Entre com suas credenciais para continuar</p>

            <div class="form-group">
                <label class="form-label">E-mail</label>
                <input class="form-control" type="email" @bind="_email"
                       placeholder="seu@email.com" autocomplete="email"
                       @onkeyup="HandleEnter" @ref="_emailInput" />
            </div>

            <div class="form-group">
                <label class="form-label">Senha</label>
                <PasswordInput @bind-Value="_senha"
                               Placeholder="••••••••"
                               Autocomplete="current-password" />
            </div>

            @if (_erro is not null)
            {
                <div class="alert alert-danger py-2 px-3 mb-3" style="font-size:.875rem">@_erro</div>
            }

            <button class="btn btn-primary w-100 py-2" @onclick="HandleLogin" disabled="@_carregando">
                @if (_carregando)
                {
                    <span class="spinner-border spinner-border-sm me-2"></span>
                }
                Entrar
            </button>

            <hr class="my-4" />

            <p class="text-center text-muted mb-0" style="font-size:.875rem">
                Ainda não tem conta?
                <a href="/cadastro" style="color:#6c63ff;font-weight:600;text-decoration:none">
                    Cadastre-se gratuitamente
                </a>
            </p>
            <p class="text-center text-muted mt-2 mb-0" style="font-size:.75rem">
                <a href="/privacidade" style="color:#adb5bd">Política de Privacidade</a>
                ·
                <a href="/termos" style="color:#adb5bd">Termos de Uso</a>
            </p>
        </div>
    </div>
</div>

@code {
    private string _email = string.Empty;
    private string _senha = string.Empty;
    private string? _erro;
    private bool _carregando;
    private ElementReference _emailInput;

    [SupplyParameterFromQuery] private string? ReturnUrl { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        if (state.User.Identity?.IsAuthenticated == true)
            Nav.NavigateTo(ReturnUrl ?? "/");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await _emailInput.FocusAsync();
    }

    private async Task HandleEnter(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await HandleLogin();
    }

    private async Task HandleLogin()
    {
        if (string.IsNullOrWhiteSpace(_email) || string.IsNullOrWhiteSpace(_senha))
        {
            _erro = "Preencha e-mail e senha.";
            return;
        }

        _carregando = true; _erro = null;
        try
        {
            var response = await Http.PostAsJsonAsync("/bff/login",
                new { Email = _email, Senha = _senha });

            if (!response.IsSuccessStatusCode)
            {
                _erro = "E-mail ou senha inválidos.";
                return;
            }

            var body = await response.Content.ReadFromJsonAsync<BffLoginResponse>();
            if (body is null) { _erro = "Resposta inválida do servidor."; return; }

            if (body.Requer2FA)
            {
                Nav.NavigateTo($"/totp?token={Uri.EscapeDataString(body.TokenTemporario ?? "")}");
                return;
            }

            AuthProvider.MarcarAutenticado(body.AccessToken!, body.Nome ?? string.Empty, body.Papel ?? string.Empty);
            Nav.NavigateTo(ReturnUrl ?? "/");
        }
        catch
        {
            _erro = "Não foi possível conectar ao servidor. Tente novamente.";
        }
        finally { _carregando = false; }
    }

    private sealed record BffLoginResponse(
        string? AccessToken, DateTime? Expiracao, string? Nome, string? Papel,
        bool Requer2FA = false, string? TokenTemporario = null);
}
