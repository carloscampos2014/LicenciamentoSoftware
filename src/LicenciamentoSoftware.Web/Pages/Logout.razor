@page "/logout"
@inject HttpClient Http
@inject JwtAuthStateProvider AuthProvider
@inject NavigationManager Nav

@code {
    protected override async Task OnInitializedAsync()
    {
        await Http.PostAsync("/bff/logout", null);
        AuthProvider.MarcarDesautenticado();
        // forceLoad: true garante que o app reinicia do zero,
        // limpando qualquer estado em memória e impedindo restauração de sessão
        Nav.NavigateTo("/login", forceLoad: true);
    }
}
