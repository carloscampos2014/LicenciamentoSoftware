@page "/sdks"
@attribute [Authorize]

<PageTitle>SDKs — LicenseManager</PageTitle>

<div class="page-header">
    <h1 class="page-title">SDKs de Integração</h1>
    <p class="page-subtitle">Bibliotecas cliente para integrar sua aplicação à API de validação de licenças.</p>
