    <pre style="background:#1e1e2e;color:#cdd6f4;border-radius:6px;padding:.75rem 1rem;font-size:.75rem;overflow-x:auto"><code>uses LicenseManagerSdk;

var Client: TLicenseManagerClient; Login: TLoginResult;
begin
  Client := TLicenseManagerClient.Create(
    'https://licensemanager-api.enzojb.com.br',
    'seu-token', 'guid-da-licenca');
  try
    Login := Client.Login('usuario@empresa.com');
    if Login.Authorized then Client.Heartbeat(Login.SessionId);
  finally Client.Free; end;
end;</code></pre>
</div>

