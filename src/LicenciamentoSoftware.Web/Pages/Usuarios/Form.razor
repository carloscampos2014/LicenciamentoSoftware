@page "/usuarios/novo"
@page "/usuarios/{Id:guid}/editar"
@attribute [Authorize(Roles = "AdministradorCliente")]
@inject UsuarioApiService Service
@inject NavigationManager Nav

<PageTitle>@(_id.HasValue ? "Editar" : "Novo") Usuário</PageTitle>

<div class="col-12 col-md-6 col-lg-5">
    <h3 class="mb-4">@(_id.HasValue ? "Editar" : "Novo") usuário</h3>

    @if (_carregando) { <p><span class="spinner-border spinner-border-sm me-1"></span>Carregando...</p> }
    else
    {
        <EditForm Model="_model" OnValidSubmit="HandleSubmit">
            <DataAnnotationsValidator />

            <div class="mb-3">
                <label class="form-label">Nome *</label>
                <InputText class="form-control" @bind-Value="_model.Nome" />
                <ValidationMessage For="@(() => _model.Nome)" />
            </div>
            <div class="mb-3">
                <label class="form-label">E-mail *</label>
                <InputText class="form-control" @bind-Value="_model.Email" type="email" />
                <ValidationMessage For="@(() => _model.Email)" />
            </div>
            @if (!_id.HasValue)
            {
                <div class="mb-3">
                    <label class="form-label">Senha *</label>
                    <InputText type="password" class="form-control" @bind-Value="_model.Senha" />
                    <ValidationMessage For="@(() => _model.Senha)" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Papel</label>
                    <InputSelect class="form-select" @bind-Value="_model.Papel">
                        <option value="OperadorCliente">Operador</option>
                        <option value="AdministradorCliente">Administrador</option>
                        <option value="Leitor">Leitor</option>
                    </InputSelect>
                </div>
            }

            <ApiError Erro="@_erro" Erros="@_erros" />

            <div class="d-flex gap-2 mt-3">
                <button type="submit" class="btn btn-primary" disabled="@_salvando">
                    @if (_salvando) { <span class="spinner-border spinner-border-sm me-1"></span> }
                    Salvar
                </button>
                <a href="/usuarios" class="btn btn-outline-secondary">Cancelar</a>
            </div>
        </EditForm>
    }
</div>

@code {
    [Parameter] public Guid? Id { get; set; }
    private Guid? _id;
    private readonly FormModel _model = new();
    private string? _erro;
    private IReadOnlyList<string>? _erros;
    private bool _carregando, _salvando;

    protected override async Task OnInitializedAsync()
    {
        _id = Id;
        if (_id.HasValue)
        {
            _carregando = true;
            var item = await Service.BuscarPorIdAsync(_id.Value);
            if (item is null) { Nav.NavigateTo("/usuarios"); return; }
            _model.Nome = item.Nome; _model.Email = item.Email;
            _carregando = false;
        }
    }

    private async Task HandleSubmit()
    {
        _salvando = true; _erro = null; _erros = null;
        bool sucesso;
        if (_id.HasValue)
        {
            var (s, _, e, erros) = await Service.AtualizarAsync(_id.Value, new(_model.Nome, _model.Email));
            sucesso = s; _erro = e; _erros = erros;
        }
        else
        {
            var (s, _, e, erros) = await Service.CriarAsync(new(_model.Nome, _model.Email, _model.Senha ?? string.Empty, _model.Papel));
            sucesso = s; _erro = e; _erros = erros;
        }
        _salvando = false;
        if (sucesso) Nav.NavigateTo("/usuarios");
    }

    private sealed class FormModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Nome é obrigatório.")]
        public string Nome { get; set; } = string.Empty;
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "E-mail é obrigatório.")]
        [System.ComponentModel.DataAnnotations.EmailAddress(ErrorMessage = "E-mail inválido.")]
        public string Email { get; set; } = string.Empty;
        public string? Senha { get; set; }
        public string? Papel { get; set; } = "OperadorCliente";
    }
}
