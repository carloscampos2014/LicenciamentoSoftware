@if (_visivel)
{
    <div class="modal fade show d-block" tabindex="-1" role="dialog" style="background:rgba(0,0,0,.5)">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@Titulo</h5>
                </div>
                <div class="modal-body">
                    <p>@Mensagem</p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="Cancelar">Cancelar</button>
                    <button class="btn btn-danger" @onclick="Confirmar">@TextoBotaoConfirmar</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool _visivel;
    private TaskCompletionSource<bool>? _tcs;

    [Parameter] public string Titulo { get; set; } = "Confirmar";
    [Parameter] public string Mensagem { get; set; } = "Deseja continuar?";
    [Parameter] public string TextoBotaoConfirmar { get; set; } = "Confirmar";

    public Task<bool> MostrarAsync()
    {
        _tcs = new TaskCompletionSource<bool>();
        _visivel = true;
        StateHasChanged();
        return _tcs.Task;
    }

    private void Confirmar()
    {
        _visivel = false;
        _tcs?.SetResult(true);
    }

    private void Cancelar()
    {
        _visivel = false;
        _tcs?.SetResult(false);
    }
}
