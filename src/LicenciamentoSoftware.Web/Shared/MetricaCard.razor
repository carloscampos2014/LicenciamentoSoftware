<div class="metric-card @(Alerta ? "metric-card--alerta" : "")">
    <div class="metric-card-header">
        <span class="metric-card-titulo">@Titulo</span>
        <div class="metric-card-icon" style="background:@Cor20">
            @if (Icone == "pessoas")
            {
                <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="@Cor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M17 20h5v-2a4 4 0 00-4-4h-1M9 20H4v-2a4 4 0 014-4h1m4-4a4 4 0 100-8 4 4 0 000 8z"/>
                </svg>
            }
            else if (Icone == "app")
            {
                <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="@Cor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M9 3H5a2 2 0 00-2 2v4m6-6h10a2 2 0 012 2v4M9 3v18m0 0h10a2 2 0 002-2V9M9 21H5a2 2 0 01-2-2V9m0 0h18"/>
                </svg>
            }
            else if (Icone == "chave")
            {
                <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="@Cor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/>
                </svg>
            }
            else if (Icone == "alerta")
            {
                <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="@Cor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                </svg>
            }
            else if (Icone == "usuarios")
            {
                <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="@Cor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197"/>
                </svg>
            }
            else if (Icone == "token")
            {
                <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="@Cor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                </svg>
            }
            else
            {
                <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="@Cor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M12 4v16m8-8H4"/>
                </svg>
            }
        </div>
    </div>
    <div class="metric-card-valor" style="color:@Cor">@Valor</div>
    <div class="metric-card-subtitulo">@Subtitulo</div>
</div>

@code {
    [Parameter, EditorRequired] public string Titulo { get; set; } = string.Empty;
    [Parameter, EditorRequired] public int Valor { get; set; }
    [Parameter] public string Subtitulo { get; set; } = string.Empty;
    [Parameter] public string Cor { get; set; } = "#6c63ff";
    [Parameter] public string Icone { get; set; } = "novo";
    [Parameter] public bool Alerta { get; set; }

    private string Cor20 => Cor + "20"; // 12% opacity via hex
}
