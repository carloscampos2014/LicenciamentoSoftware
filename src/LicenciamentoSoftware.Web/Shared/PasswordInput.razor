@* Componente reutilizável para campos de senha com:
   - Botão olhinho para alternar visibilidade
   - Indicador de força opcional (MostrarForca=true)
*@

<div class="password-input-wrapper">
    <input class="form-control @CssClass"
           type="@(_visivel ? "text" : "password")"
           value="@Value"
           @oninput="HandleInput"
           placeholder="@Placeholder"
           autocomplete="@Autocomplete"
           id="@Id" />

    <button type="button"
            class="password-toggle-btn"
            @onclick="ToggleVisibilidade"
            aria-label="@(_visivel ? "Ocultar senha" : "Mostrar senha")"
            tabindex="-1">
        @if (_visivel)
        {
            @* Olho aberto — senha visível *@
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                <circle cx="12" cy="12" r="3"/>
            </svg>
        }
        else
        {
            @* Olho fechado — senha oculta *@
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94"/>
                <path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"/>
                <line x1="1" y1="1" x2="23" y2="23"/>
            </svg>
        }
    </button>
</div>

@if (MostrarForca && !string.IsNullOrEmpty(Value))
{
    <div class="password-forca-container">
        <div class="password-forca-barra">
            @for (int i = 1; i <= 4; i++)
            {
                var nivel = i;
                <div class="password-forca-segmento @(CalcularForca() >= nivel ? $"forca-{CalcularForca()}" : "forca-vazio")"></div>
            }
        </div>
        <span class="password-forca-label @($"forca-label-{CalcularForca()}")">
            @DescricaoForca()
        </span>
    </div>
}

@code {
    [Parameter] public string Value { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public string Placeholder { get; set; } = "••••••••";
    [Parameter] public string Autocomplete { get; set; } = "current-password";
    [Parameter] public bool MostrarForca { get; set; } = false;
    [Parameter] public string CssClass { get; set; } = string.Empty;
    [Parameter] public string Id { get; set; } = string.Empty;

    private bool _visivel;

    private void ToggleVisibilidade() => _visivel = !_visivel;

    private async Task HandleInput(ChangeEventArgs e)
    {
        Value = e.Value?.ToString() ?? string.Empty;
        await ValueChanged.InvokeAsync(Value);
    }

    private int CalcularForca()
    {
        if (string.IsNullOrEmpty(Value)) return 0;

        int nivel = 0;
        if (Value.Length >= 8)                                  nivel++;
        if (Value.Any(char.IsUpper))                            nivel++;
        if (Value.Any(char.IsDigit))                            nivel++;
        if (Value.Any(c => "!@#$%^&*".Contains(c)))            nivel++;

        return nivel;
    }

    private string DescricaoForca() => CalcularForca() switch
    {
        0 => string.Empty,
        1 => "Muito fraca",
        2 => "Fraca",
        3 => "Média",
        4 => "Forte",
        _ => string.Empty
    };
}
