<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Suprimir diagnosticos do Dapper AOT analyzer nos testes de integracao:
         DAP005: TestDatabase usa dynamic e SQL nao-estatico incompativel com AOT
         DAP028: .ToList() vs .AsList() — padrao de teste, nao codigo de producao
         DAP037: tipo dynamic em AuditLogTests — intencional para validar schema do banco -->
    <NoWarn>$(NoWarn);DAP005;DAP028;DAP037</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.0.1" />
    <PackageReference Include="FluentAssertions" Version="7.2.2" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="Microsoft.OpenApi" Version="2.12.2" />
    <PackageReference Include="Npgsql" Version="9.0.3" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\LicenciamentoSoftware.Application\LicenciamentoSoftware.Application.csproj" />
    <ProjectReference Include="..\..\src\LicenciamentoSoftware.Infrastructure\LicenciamentoSoftware.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\LicenciamentoSoftware.Api\LicenciamentoSoftware.Api.csproj" />
  </ItemGroup>

</Project>